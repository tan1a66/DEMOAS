{
  "name": "buenquerer",
  "private": true,
  "version": "0.1.0",
  "description": "buenquerer — demo privata (proposta Alessia Studio). Non è il sito ufficiale.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:anteprima": "vite build --config vite.preview.config.js && node -e \"require('fs').renameSync('anteprima/index.html','anteprima/buenquerer-anteprima.html')\"",
