    "build:vercel": "vite build --config vite.preview.config.js --outDir deploy"
  },
  "dependencies": {
    "gsap": "3.12.5",
    "three": "0.169.0"
  },
  "devDependencies": {
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.3"
  }
}
