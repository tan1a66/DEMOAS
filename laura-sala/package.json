{
  "name": "laura-sala-velata",
  "private": true,
  "version": "0.1.0",
  "description": "Dott.ssa Laura Sala — demo privata \"Velata\" (proposta Alessia Studio). Non è il sito ufficiale.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:anteprima": "vite build --config vite.preview.config.js && node -e \"require('fs').renameSync('anteprima/index.html','anteprima/velata-anteprima.html')\"",
    "build:anteprima-tonda": "VITE_FORMA=tonda vite build --config vite.preview.config.js && node -e \"require('fs').renameSync('anteprima/index.html','anteprima/velata-anteprima-tonda.html')\""
  },
  "dependencies": {
    "gsap": "3.12.5",
    "three": "0.169.0"
  },
  "devDependencies": {
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.3"
  }
}
