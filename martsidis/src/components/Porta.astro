---
/**
 * Entrata del sito, come un piccolo film in 3D (CSS 3D: un mondo con pareti, porta, sedie, e una camera che si muove).
 * 1. Primissimo piano della porta dello studio: legno, maniglia a sinistra, targa in ottone (stesse diciture della
 *    targa vera) al centro dello schermo, e il pulsante "ENTRA".
 * 2. La porta (misura normale, ~90 cm) si socchiude di ~60 cm; la camera arretra appena e passa nello spiraglio.
 * 3. Dentro, la camera guarda a destra: sulla parete di destra il quadro dei fiori bianchi e sotto le quattro sedie;
 *    in fondo a sinistra il passaggio verso lo studio del Dottore (scrivania, lettino). Inquadrature di scorcio.
 * 4. La camera entra nel quadro: i fiori diventano lo sfondo dove la ragazza cammina; poi resta la Home.
 * Ogni volta che si apre la Home; mai con "riduci movimento". Senza JavaScript "ENTRA" funziona lo stesso.
 * Unità: 1vh ≈ 2,7 cm (la stanza è alta 100vh). Origine: centro della porta sul pavimento; y verso il basso.
 */

// Fiori del quadro (sempre uguali): bianchi con il cuore dorato, su fondo tortora
let seme = 11;
const caso = () => (seme = (seme * 16807) % 2147483647) / 2147483647;
const fiori = Array.from({ length: 230 }, (_, i) => ({
  v: i % 5, // variante di volo quando si dissolvono
  x: 5 + caso() * 990,
  y: 22 + caso() * 165,
  r: 7 + caso() * 11,
  a: caso() * 72,
}));
// il prato: entrati nel quadro i fiori diventano grandi e scendono in basso, dove cammina la ragazza
const prato = fiori.map((f) => ({ ...f, yp: 182 + caso() * 26, sp: 1.25 + caso() * 0.6 }));
const steli = Array.from({ length: 110 }, () => ({ x: 10 + caso() * 980, y: 110 + caso() * 80 }));
---

<div class="porta" data-porta>
  <span id="benvenuta" class="porta__ancora"></span>
  <div class="porta__scena" aria-hidden="true">
    <!-- due scene con la stessa camera: dietro la stanza, davanti corridoio e porta (così la porta non finisce mai
         dietro la stanza per un errore di ordinamento dei piani 3D) -->
    <div class="mondo">
      <!-- la sala d'attesa -->
      <div class="m pav"><span class="ombre-pav"></span></div>
      <div class="m soff"><span class="luce"></span></div>
            <div class="m parete-sx"></div>
<div class="m parete-dx">
        <span class="ombre-sedie"></span>
        <svg class="quadro" viewBox="0 0 1000 210" preserveAspectRatio="none">
          <defs>
            <linearGradient id="st-quadro" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#d4cbb8" />
              <stop offset="0.6" stop-color="#bab19d" />
              <stop offset="1" stop-color="#a8a496" />
            </linearGradient>
          </defs>
          <rect width="1000" height="210" fill="url(#st-quadro)" />
          {steli.map((s) => <line x1={s.x} y1={s.y} x2={s.x + 3} y2="210" stroke="#97978a" stroke-width="1.6" opacity="0.55" />)}
          {
            fiori.map((f) => (
              <g transform={`translate(${f.x.toFixed(1)} ${f.y.toFixed(1)}) rotate(${f.a.toFixed(0)})`}>
                {[0, 72, 144, 216, 288].map((r) => (
                  <ellipse cx="0" cy={(-f.r * 0.55).toFixed(1)} rx={(f.r * 0.42).toFixed(1)} ry={(f.r * 0.6).toFixed(1)} fill="#fbfaf6" transform={`rotate(${r})`} />
                ))}
                <circle r={(f.r * 0.22).toFixed(1)} fill="#9a78c2" />
              </g>
            ))
          }
        </svg>
      </div>
      <div class="m fondo fondo--a"></div>
      <!-- quattro sedie sotto il quadro, contro la parete di destra -->
      <div class="sedia sedia--1"><span class="sd-ombra"></span><span class="sd-ombra-muro"></span><span class="sd-gamba sd-gamba--1"></span><span class="sd-gamba sd-gamba--2"></span><span class="sd-gamba sd-gamba--3"></span><span class="sd-gamba sd-gamba--4"></span><span class="sd-sopra"></span><span class="sd-fronte"></span><span class="sd-lato sd-lato--sx"></span><span class="sd-lato sd-lato--dx"></span><span class="sd-schienale"></span><span class="sd-schienale-lato sd-schienale-lato--sx"></span><span class="sd-schienale-lato sd-schienale-lato--dx"></span><span class="sd-schienale-cima"></span><span class="sd-schienale-retro"></span><span class="sd-ala sd-ala--sx"></span><span class="sd-ala sd-ala--dx"></span><span class="sd-retro"></span></div>
        <div class="sedia sedia--2"><span class="sd-ombra"></span><span class="sd-ombra-muro"></span><span class="sd-gamba sd-gamba--1"></span><span class="sd-gamba sd-gamba--2"></span><span class="sd-gamba sd-gamba--3"></span><span class="sd-gamba sd-gamba--4"></span><span class="sd-sopra"></span><span class="sd-fronte"></span><span class="sd-lato sd-lato--sx"></span><span class="sd-lato sd-lato--dx"></span><span class="sd-schienale"></span><span class="sd-schienale-lato sd-schienale-lato--sx"></span><span class="sd-schienale-lato sd-schienale-lato--dx"></span><span class="sd-schienale-cima"></span><span class="sd-schienale-retro"></span><span class="sd-ala sd-ala--sx"></span><span class="sd-ala sd-ala--dx"></span><span class="sd-retro"></span></div>
        <div class="sedia sedia--3"><span class="sd-ombra"></span><span class="sd-ombra-muro"></span><span class="sd-gamba sd-gamba--1"></span><span class="sd-gamba sd-gamba--2"></span><span class="sd-gamba sd-gamba--3"></span><span class="sd-gamba sd-gamba--4"></span><span class="sd-sopra"></span><span class="sd-fronte"></span><span class="sd-lato sd-lato--sx"></span><span class="sd-lato sd-lato--dx"></span><span class="sd-schienale"></span><span class="sd-schienale-lato sd-schienale-lato--sx"></span><span class="sd-schienale-lato sd-schienale-lato--dx"></span><span class="sd-schienale-cima"></span><span class="sd-schienale-retro"></span><span class="sd-ala sd-ala--sx"></span><span class="sd-ala sd-ala--dx"></span><span class="sd-retro"></span></div>
        <div class="sedia sedia--4"><span class="sd-ombra"></span><span class="sd-ombra-muro"></span><span class="sd-gamba sd-gamba--1"></span><span class="sd-gamba sd-gamba--2"></span><span class="sd-gamba sd-gamba--3"></span><span class="sd-gamba sd-gamba--4"></span><span class="sd-sopra"></span><span class="sd-fronte"></span><span class="sd-lato sd-lato--sx"></span><span class="sd-lato sd-lato--dx"></span><span class="sd-schienale"></span><span class="sd-schienale-lato sd-schienale-lato--sx"></span><span class="sd-schienale-lato sd-schienale-lato--dx"></span><span class="sd-schienale-cima"></span><span class="sd-schienale-retro"></span><span class="sd-ala sd-ala--sx"></span><span class="sd-ala sd-ala--dx"></span><span class="sd-retro"></span></div>
        
    </div>
    <div class="mondo">
      <!-- corridoio: il muro con il vano della porta -->
      <div class="m fuori muro-fuori muro-fuori--sx"></div>
      <div class="m fuori muro-fuori muro-fuori--dx"></div>
      <div class="m fuori muro-fuori muro-fuori--su"></div>
      <div class="m fuori stipite stipite--sx"></div>
      <div class="m fuori stipite stipite--dx"></div>
      <div class="m fuori stipite stipite--su"></div>
      <!-- lo spessore del muro nel vano: la porta non è un foglio, è dentro un muro -->
      <div class="m fuori vano vano--sx"></div>
      <div class="m fuori vano vano--dx"></div>
      <div class="m fuori vano vano--su"></div>
      <!-- la luce della sala che esce sul pavimento del corridoio mentre la porta si apre -->
      <div class="m fuori luce-corridoio"></div>

      <!-- la porta: cardine nell'angolo destro, si apre verso l'interno fino alla parete -->
      <div class="m anta">
        <div class="anta__spessore"></div>
        <div class="anta__venature"></div>
        <div class="targa">
          <span class="vite vite--1"></span><span class="vite vite--2"></span>
          <span class="vite vite--3"></span><span class="vite vite--4"></span>
          <span class="targa__nome">Dott. Konstantinos Martsidis</span>
          <span class="targa__ruolo">Medico Chirurgo</span>
          <span class="targa__righe">Specialista in Ginecologia ed Ostetricia<br />Esperto in Uroginecologia</span>
          <span class="targa__piede"><span>Tel.: 3207903754</span><span>Riceve per appuntamento</span></span>
        </div>
        <div class="maniglia"></div>
      </div>
    </div>
  </div>
  <!-- il quadro a tutto schermo: si entra nei fiori ed è lì che la donna cammina -->
  <svg class="porta__prato" viewBox="0 0 1000 210" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect class="prato__fondo" width="1000" height="210" fill="url(#st-quadro)" />
    {steli.map((s) => <line class="prato__stelo" x1={s.x} y1={s.y} x2={s.x + 3} y2="210" stroke="#97978a" stroke-width="1.6" opacity="0.55" />)}
    {
      prato.map((f) => (
        <g transform={`translate(${f.x.toFixed(1)} ${f.y.toFixed(1)})`}>
          <animateTransform
            attributeName="transform"
            type="translate"
            from={`${f.x.toFixed(1)} ${f.y.toFixed(1)}`}
            to={`${f.x.toFixed(1)} ${f.yp.toFixed(1)}`}
            dur="3s"
            begin="indefinite"
            fill="freeze"
            calcMode="spline"
            keySplines="0.4 0 0.2 1"
          />
          <line x1="0" y1="0" x2="1" y2="40" stroke="#8f9480" stroke-width="1.4" class="prato__gambo" />
          <g transform={`rotate(${f.a.toFixed(0)})`}>
            <animateTransform attributeName="transform" type="scale" additive="sum" from="1" to={f.sp.toFixed(2)} dur="3s" begin="indefinite" fill="freeze" />
            {[0, 72, 144, 216, 288].map((r) => (
              <ellipse cx="0" cy={(-f.r * 0.55).toFixed(1)} rx={(f.r * 0.42).toFixed(1)} ry={(f.r * 0.6).toFixed(1)} fill="#fbfaf6" transform={`rotate(${r})`} />
            ))}
            <circle r={(f.r * 0.22).toFixed(1)} fill="#9a78c2" />
          </g>
        </g>
      ))
    }
  </svg>
  <!-- targa a piena risoluzione (nitida) sopra quella 3D, finché la porta è chiusa: stessa posizione e misura -->
  <div class="targa-nitida" aria-hidden="true">
    <span class="vite vite--1"></span><span class="vite vite--2"></span>
    <span class="vite vite--3"></span><span class="vite vite--4"></span>
    <span class="targa__nome">Dott. Konstantinos Martsidis</span>
    <span class="targa__ruolo">Medico Chirurgo</span>
    <span class="targa__righe">Specialista in Ginecologia ed Ostetricia<br />Esperto in Uroginecologia</span>
    <span class="targa__piede"><span>Tel.: 3207903754</span><span>Riceve per appuntamento</span></span>
  </div>
  <a class="porta__entra" href="#benvenuta" data-porta-entra>ENTRA</a>
</div>

<script>
  const porta = document.querySelector<HTMLElement>('[data-porta]');
  if (porta) {
    const w = window as Window & { __portaChiusa?: boolean };
    const html = document.documentElement;
    const salta = () => {
      porta.classList.add('porta--salta');
      w.__portaChiusa = false;
      html.classList.remove('porta-chiusa');
    };
    // le sedie vere (WebGL) tra la stanza e la porta: si preparano subito, si animano dopo "ENTRA"
    let sedie: { avvia: () => void; dispose: () => void } | null = null;
    const scena = porta.querySelector<HTMLElement>('.porta__scena');
    const mondi = porta.querySelectorAll<HTMLElement>('.mondo');
    const preparaSedie = async () => {
      try {
        if (!scena || mondi.length < 2 || !('WebGLRenderingContext' in window)) return;
        const { montaStanza } = await import('@/three/porta/stanza');
        sedie = await montaStanza(scena, mondi[0]!, mondi[1]!);
        if (porta.classList.contains('porta--aperta')) sedie.avvia();
      } catch {
        /* restano le sedie disegnate in CSS */
      }
    };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) salta();
    else {
      void preparaSedie();
      w.__portaChiusa = true;
      html.classList.add('porta-chiusa'); // niente scroll finché non si entra
      const entra = porta.querySelector<HTMLAnchorElement>('[data-porta-entra]');
      requestAnimationFrame(() => entra?.focus({ preventScroll: true }));
      const apri = (e?: Event) => {
        e?.preventDefault();
        if (porta.classList.contains('porta--aperta')) return;
        porta.classList.add('porta--aperta');
        sedie?.avvia();
        // la camera è entrata nel quadro: la donna cammina tra i fiori
        setTimeout(() => {
          sedie?.dispose();
          porta.classList.add('porta--dentro');
          // i fiori diventano grandi e scendono: il prato dove cammina la ragazza
          porta.querySelectorAll<SVGAnimationElement>('.porta__prato animateTransform').forEach((a) => a.beginElement());
          html.classList.remove('porta-chiusa');
          w.__portaChiusa = false;
          window.dispatchEvent(new Event('porta-aperta'));
        }, 7000);
        // quando si è fermata il prato lascia il posto alla Home
        setTimeout(() => porta.classList.add('porta--via'), 14500);
        setTimeout(salta, 16000);
      };
      porta.addEventListener('click', apri);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !porta.classList.contains('porta--aperta')) apri(e);
      });
    }
  }
</script>

<style>
  .porta {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #e9e4dc;
    cursor: pointer;
    overflow: hidden;
  }
  .porta--salta {
    display: none;
  }
  .porta__scena {
    position: absolute;
    inset: 0;
    perspective: 100vh;
    perspective-origin: 50% 50%;
  }
  /* il mondo: un punto al centro dello schermo; la camera è il suo transform (il mondo si muove al contrario) */
  .mondo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    /* primissimo piano sulla targa */
    transform: rotateY(0deg) translate3d(0vh, 50vh, 80vh);
  }
  .porta--aperta .mondo,
  .porta:has(.porta__ancora:target) .mondo {
    animation: camera 7s linear forwards;
  }
  /* rotateY(φ) translate3d(-C): C è il punto inquadrato al centro dello schermo, φ quanto si guarda a destra */
  /* un unico movimento, senza soste. Il primo arrivo è l'inquadratura della foto: la porta si apre verso di noi,
     l'anta con la targa a destra in primo piano, nello spiraglio di scorcio la parete di destra con il quadro e le
     sedie. Poi si entra e si va nel quadro. */
  /* camera: occhio E, sguardo φ (0 = dritto nella porta, 90° = verso la parete di destra);
     nel transform: rotateY(φ) translate3d(-C), con C = E + 100vh · direzione dello sguardo */
  /* lo sguardo punta sempre al centro del quadro (sulla parete a ~2,5 m a sinistra della porta) */
  @keyframes camera {
    0% {
      /* davanti alla porta chiusa, sulla targa */
      transform: rotateY(0deg) translate3d(0vh, 50vh, 80vh);
      animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
    }
    14% {
      /* la porta si apre: si avanza verso lo spiraglio, lo sguardo già verso il quadro */
      transform: rotateY(-30deg) translate3d(47vh, 51vh, 84.6vh);
    }
    24% {
      /* appena oltre la soglia: il quadro quasi di fronte, stipite e muro restano fuori dall'inquadratura */
      transform: rotateY(-58.5deg) translate3d(80.3vh, 51vh, 58.2vh);
    }
    38% {
      transform: rotateY(-58.8deg) translate3d(82.5vh, 51vh, 59.8vh);
      animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1);
    }
    60% {
      transform: rotateY(-58.3deg) translate3d(120.1vh, 53vh, 82.6vh);
    }
    82% {
      transform: rotateY(-68.4deg) translate3d(163vh, 54vh, 96.8vh);
      animation-timing-function: cubic-bezier(0.3, 0.2, 0.3, 1);
    }
    100% {
      /* dritti davanti al quadro, così vicini che riempie lo schermo: coincide al pixel con il prato */
      transform: rotateY(-90deg) translate3d(191vh, 55vh, 74.8vh);
    }
  }




  .m {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    transform-style: preserve-3d;
  }

  /* — corridoio — */
  .muro-fuori {
    background: linear-gradient(180deg, #ece7df, #e2dcd2);
  }
  .muro-fuori--sx {
    width: 300vh;
    height: 300vh;
    transform: translate3d(-318vh, -200vh, 0.2vh);
  }
  .muro-fuori--dx {
    width: 300vh;
    height: 300vh;
    transform: translate3d(18vh, -200vh, 0.2vh);
  }
  .muro-fuori--su {
    width: 36vh;
    height: 122vh;
    transform: translate3d(-18vh, -200vh, 0.2vh);
  }
  .stipite {
    background: linear-gradient(90deg, #8d5c2e, #a8733f);
  }
  .stipite--sx {
    width: 1.6vh;
    height: 79.6vh;
    transform: translate3d(-18vh, -79.6vh, 0.3vh);
  }
  .stipite--dx {
    width: 1.6vh;
    height: 79.6vh;
    transform: translate3d(16.5vh, -79.6vh, 0.3vh);
  }
  .stipite--su {
    width: 36vh;
    height: 1.6vh;
    transform: translate3d(-18vh, -79.6vh, 0.3vh);
  }

  /* il corridoio sta nella scena davanti: varcata la soglia (dopo ~1,6 s) non serve più e si nasconde */
  .porta--aperta .fuori {
    animation: fuori-via 0.01s linear 3.8s forwards;
  }
  @keyframes fuori-via {
    to {
      visibility: hidden;
    }
  }
  /* spessore del muro nel vano della porta (12 cm) */
  .vano {
    background: linear-gradient(90deg, #cdbfa9, #dacdb9);
  }
  .vano--sx {
    width: 4.5vh;
    height: 78vh;
    transform: translate3d(-16.1vh, -77.7vh, 0) rotateY(90deg);
  }
  .vano--dx {
    width: 4.5vh;
    height: 78vh;
    transform: translate3d(16.5vh, -78vh, 0) rotateY(90deg);
    background: linear-gradient(90deg, #bfb19b, #cfc2ad);
  }
  .vano--su {
    width: 33vh;
    height: 4.5vh;
    transform: translate3d(-16.5vh, -78vh, 0) rotateX(-90deg);
    background: #c9bba5;
  }
  .luce-corridoio {
    width: 60vh;
    height: 70vh;
    transform: translate3d(-30vh, -0.2vh, 70vh) rotateX(-90deg);
    background: radial-gradient(55% 75% at 55% 100%, rgb(255 246 222 / 0.85), transparent 70%);
    opacity: 0;
  }
  .porta--aperta .luce-corridoio {
    animation:
      luce-entra 1.2s ease 0.3s forwards,
      fuori-via 0.01s linear 3.8s forwards;
  }
  @keyframes luce-entra {
    to {
      opacity: 1;
    }
  }
  /* il corridoio è più in ombra della sala: entrando si va verso la luce */
  .porta__scena::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(120% 90% at 50% 45%, transparent 55%, rgb(40 28 16 / 0.28));
    transition: opacity 1.8s ease 0.6s;
  }
  .porta--aperta .porta__scena::after {
    opacity: 0;
  }

  /* — la sala d'attesa, come nella pianta: la porta è nell'angolo destro (cardine sull'angolo) e si apre verso
     l'interno fino alla parete di destra; subito dopo, sulla stessa parete, il quadro e sotto le sedie.
     Il resto della stanza non si vede. x da -100 a 16.5vh, z da 0 a -160vh, alta 100vh (1vh ≈ 2,7 cm) — */
  .pav {
    width: 116.5vh;
    height: 160vh;
    transform: translate3d(-100vh, 0, -0.8vh) rotateX(-90deg);
    background: linear-gradient(180deg, #c7b392, #d6c6aa);
  }
  .soff {
    width: 116.5vh;
    height: 160vh;
    transform: translate3d(-100vh, -100vh, -0.8vh) rotateX(-90deg);
    background: linear-gradient(180deg, #ddd7ce, #e6e1d9);
  }
  .luce {
    position: absolute;
    left: 55%;
    top: 18%;
    width: 30%;
    height: 40%;
    background: #fff;
    box-shadow: 0 0 6vh 2vh rgb(255 252 235 / 0.9);
  }
  .parete-sx {
    width: 160vh;
    height: 100vh;
    transform: translate3d(-100vh, -100vh, -0.8vh) rotateY(90deg);
    background: linear-gradient(90deg, #d9d1c5, #cfc7ba);
  }
  .parete-dx {
    width: 160vh;
    height: 100vh;
    transform: translate3d(17.4vh, -100vh, -0.8vh) rotateY(90deg);
    background:
      radial-gradient(60% 70% at 60% 40%, rgb(255 250 240 / 0.5), transparent 70%),
      linear-gradient(90deg, #d8d0c3, #e6ded2 25%, #ece6dc 60%, #e2dbd0);
    box-shadow: inset 0 -2.6vh 0 #d9d2c6;
  }
  /* ombre di contatto delle sedie: sulla parete dietro gli schienali e sul pavimento sotto le sedute */
  .ombre-sedie {
    position: absolute;
    left: 28%;
    width: 46%;
    bottom: 0;
    height: 40%;
    background:
      radial-gradient(9% 70% at 12% 75%, rgb(70 55 40 / 0.26), transparent),
      radial-gradient(9% 70% at 37% 75%, rgb(70 55 40 / 0.26), transparent),
      radial-gradient(9% 70% at 62% 75%, rgb(70 55 40 / 0.26), transparent),
      radial-gradient(9% 70% at 87% 75%, rgb(70 55 40 / 0.26), transparent);
    filter: blur(0.8vh);
  }
  .ombre-pav {
    position: absolute;
    right: 0;
    width: 17%;
    top: 28%;
    height: 48%;
    background: linear-gradient(270deg, rgb(70 55 40 / 0.24), transparent);
    filter: blur(1vh);
  }
  /* il quadro sulla parete di destra, subito dopo la porta, sopra le sedie */
  .parete-dx .quadro {
    position: absolute;
    left: 22.5%;
    top: 37%;
    width: 47.5%;
    height: 16%; /* 76 × 16vh: le stesse proporzioni del prato a tutto schermo (1000 × 210) */
