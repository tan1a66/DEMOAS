---
/**
 * Entrata del sito, in tre tempi:
 * 1. la porta dello studio è chiusa (legno e targa in ottone, come quella vera) con il pulsante "Entra";
 * 2. toccando "Entra" la porta si apre e dietro c'è lo studio (la foto src/assets/foto/porta.jpg);
 * 3. si entra nello studio: la foto resta, sfocata e leggera, dietro alla donna che entra camminando,
 *    poi lascia il posto alla Home.
 * Una volta per visita (sessionStorage), mai con "riduci movimento". Senza JavaScript "Entra" è un link
 * e l'apertura è solo CSS (:target).
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { sito } from '@/data/sito';

const foto = import.meta.glob<{ default: ImageMetadata }>('/src/assets/foto/porta.{jpg,jpeg,png,webp}', { eager: true });
const sorgente = Object.values(foto)[0]?.default;
const img = sorgente ? await getImage({ src: sorgente, width: 1600, format: 'webp' }) : null;
---

<div class="porta" data-porta>
  <span id="benvenuta" class="porta__ancora"></span>
  {
    img && (
      <div class="porta__studio" aria-hidden="true">
        <img class="porta__sfondo" src={img.src} alt="" />
        <img class="porta__foto" src={img.src} alt="" width={img.attributes.width} height={img.attributes.height} />
      </div>
    )
  }
  <div class="porta__anta" aria-hidden="true">
    <div class="porta__venature"></div>
    <div class="porta__targa">
      <span class="porta__nome">{sito.nome}</span>
      <span class="porta__ruolo">Medico Chirurgo</span>
      <span class="porta__righe">Specialista in Ginecologia ed Ostetricia<br />Esperto in Uroginecologia</span>
      <span class="porta__riceve">Riceve per appuntamento</span>
    </div>
    <div class="porta__pomello"></div>
  </div>
  <a class="porta__entra" href="#benvenuta" data-porta-entra>Entra</a>
</div>

<script>
  const porta = document.querySelector<HTMLElement>('[data-porta]');
  if (porta) {
    let vista = false;
    try {
      vista = sessionStorage.getItem('porta-vista') === '1';
    } catch {
      /* navigazione privata */
    }
    const w = window as Window & { __portaChiusa?: boolean };
    const salta = () => {
      porta.classList.add('porta--salta');
      w.__portaChiusa = false;
      document.documentElement.classList.remove('porta-chiusa');
    };
    if (vista || matchMedia('(prefers-reduced-motion: reduce)').matches) salta();
    else {
      w.__portaChiusa = true;
      document.documentElement.classList.add('porta-chiusa'); // niente scroll finché non si entra
      const entra = porta.querySelector<HTMLAnchorElement>('[data-porta-entra]');
      requestAnimationFrame(() => entra?.focus({ preventScroll: true }));
      const apri = (e?: Event) => {
        e?.preventDefault();
        if (porta.classList.contains('porta--aperta')) return;
        porta.classList.add('porta--aperta');
        try {
          sessionStorage.setItem('porta-vista', '1');
        } catch {
          /* ok */
        }
        // 2,4 s: si è entrati. Lo studio resta dietro, la donna entra camminando
        setTimeout(() => {
          porta.classList.add('porta--dentro');
          w.__portaChiusa = false;
          document.documentElement.classList.remove('porta-chiusa');
          window.dispatchEvent(new Event('porta-aperta'));
        }, 2400);
        // quando lei si è fermata lo studio lascia il posto alla Home
        setTimeout(() => porta.classList.add('porta--via'), 8200);
        setTimeout(salta, 9800);
      };
      porta.addEventListener('click', apri);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !porta.classList.contains('porta--aperta')) apri(e);
      });
    }
  }
</script>

<style>
  .porta {
    position: fixed;
    inset: 0;
    z-index: 100;
    perspective: 1800px;
    perspective-origin: 0% 50%;
    background: #2a2118;
    cursor: pointer;
  }
  .porta--salta {
    display: none;
  }

  /* — lo studio, dietro la porta — */
  .porta__studio {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform-origin: 40% 62%;
    transition:
      transform 3.2s cubic-bezier(0.45, 0, 0.2, 1),
      filter 1.6s ease,
      opacity 1.6s ease;
  }
  .porta__sfondo {
    position: absolute;
    inset: -40px;
    width: calc(100% + 80px);
    height: calc(100% + 80px);
    object-fit: cover;
    filter: blur(28px) brightness(0.85);
  }
  .porta__foto {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 45%;
  }
  @media (min-aspect-ratio: 4/5) {
    /* schermo largo: la foto (verticale) si vede tutta, al centro, su uno sfondo sfocato della stessa foto */
    .porta__foto {
      object-fit: contain;
    }
  }
  /* si entra: lo studio si avvicina */
  .porta--aperta .porta__studio {
    transform: scale(1.35);
  }
  /* dentro: lo studio resta dietro alla donna, sfocato e leggero; la Home è davanti */
  .porta--dentro {
    z-index: -1;
    background: transparent;
    pointer-events: none;
  }
  .porta--dentro .porta__studio {
    filter: blur(6px) saturate(0.9);
    opacity: 0.32;
  }
  .porta--via .porta__studio {
    opacity: 0;
  }

  /* — la porta chiusa — */
  .porta__anta {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform-origin: 0% 50%;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.22), transparent 3%, transparent 97%, rgb(0 0 0 / 0.25)),
      linear-gradient(180deg, #cf9a62, #bd8248 55%, #ab713a);
    box-shadow: 0 0 80px rgb(30 20 10 / 0.35);
    will-change: transform;
  }
  .porta__anta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(20 12 6);
    opacity: 0;
  }
  .porta--aperta .porta__anta,
  .porta:has(.porta__ancora:target) .porta__anta {
    animation: porta-apre 2.2s cubic-bezier(0.55, 0, 0.2, 1) forwards;
  }
  .porta--aperta .porta__anta::after,
  .porta:has(.porta__ancora:target) .porta__anta::after {
    animation: porta-ombra 2.2s cubic-bezier(0.55, 0, 0.2, 1) forwards;
  }
  .porta--dentro .porta__anta {
    visibility: hidden;
  }
  /* senza JavaScript: appena si entra la porta non blocca più nulla e lo studio sfuma */
  .porta:has(.porta__ancora:target) {
    pointer-events: none;
    background: transparent;
  }
  .porta:has(.porta__ancora:target) .porta__studio {
    animation: studio-via 1.2s ease 2.2s forwards;
  }
  .porta__venature {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    background: repeating-linear-gradient(
      92deg,
      transparent 0 18px,
      rgb(120 70 30 / 0.25) 18px 19px,
      transparent 19px 41px,
      rgb(255 220 180 / 0.12) 41px 42px
    );
  }
  .porta__targa {
    position: absolute;
    top: 16%;
    right: 8%;
    display: grid;
    gap: 0.3rem;
    width: min(26rem, 72vw);
    padding: clamp(1rem, 3vw, 1.75rem) clamp(1rem, 3vw, 2rem);
    border-radius: 3px;
    background: linear-gradient(135deg, #e9cf8e, #c9a456 45%, #e6c983 70%, #b8913f);
    box-shadow: 0 6px 18px rgb(40 25 5 / 0.35), inset 0 1px 0 rgb(255 255 255 / 0.5);
    color: #3a2a12;
    font-family: Georgia, 'Times New Roman', serif;
    text-align: center;
  }
  .porta__nome {
    font-size: clamp(1.05rem, 0.8rem + 1.4vw, 1.6rem);
  }
  .porta__ruolo {
    font-size: clamp(0.75rem, 0.65rem + 0.4vw, 0.95rem);
    font-style: italic;
  }
  .porta__righe {
    margin-top: 0.5rem;
    font-size: clamp(0.85rem, 0.7rem + 0.6vw, 1.1rem);
    line-height: 1.35;
  }
  .porta__riceve {
    margin-top: 0.6rem;
    font-size: 0.85rem;
  }
  .porta__pomello {
    position: absolute;
    top: 58%;
    right: 7%;
    width: clamp(2.8rem, 6vw, 4rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff3c8, #d6b25e 40%, #8f6a22 85%);
    box-shadow: 0 8px 16px rgb(40 25 5 / 0.45);
  }

  /* — "Entra" — */
  .porta__entra {
    position: absolute;
    left: 50%;
    bottom: max(12vh, 5rem);
    translate: -50% 0;
    z-index: 2;
    padding: 0.95rem 2.6rem;
    border-radius: 999px;
    border: 1px solid rgb(255 240 200 / 0.75);
    background: rgb(45 30 60 / 0.82);
    backdrop-filter: blur(6px);
    color: #fff6dc;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    box-shadow: 0 10px 30px rgb(30 20 10 / 0.35);
    animation: entra-respira 2.4s ease-in-out infinite;
  }
  .porta__entra:hover,
  .porta__entra:focus-visible {
    background: rgb(45 30 60 / 0.95);
    outline: 2px solid #fff6dc;
    outline-offset: 4px;
  }
  .porta--aperta .porta__entra,
  .porta:has(.porta__ancora:target) .porta__entra {
    opacity: 0;
    transition: opacity 0.4s;
  }
  .porta__ancora {
    position: absolute;
    top: 0;
  }
  :global(html.porta-chiusa) {
    overflow: hidden;
  }
  @keyframes entra-respira {
    50% {
      box-shadow: 0 10px 30px rgb(30 20 10 / 0.35), 0 0 0 10px rgb(255 240 200 / 0.12);
    }
  }
  @keyframes porta-apre {
    to {
      transform: rotateY(-104deg);
    }
  }
  @keyframes porta-ombra {
    to {
      opacity: 0.45;
    }
  }
  @keyframes studio-via {
    to {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .porta {
      display: none;
    }
  }
</style>
