---
/**
 * Entrata del sito, come un piccolo film in 3D (CSS 3D: un mondo con pareti, porta, sedie, e una camera che si muove).
 * 1. Primissimo piano della porta dello studio: legno, maniglia a sinistra, targa in ottone (stesse diciture della
 *    targa vera) al centro dello schermo, e il pulsante "ENTRA".
 * 2. La porta (misura normale, ~90 cm) si socchiude di ~60 cm; la camera arretra appena e passa nello spiraglio.
 * 3. Dentro, la camera guarda a destra: sulla parete di destra il quadro dei fiori bianchi e sotto le quattro sedie;
 *    in fondo a sinistra il passaggio verso lo studio del Dottore (scrivania, lettino). Inquadrature di scorcio.
 * 4. La camera entra nel quadro: i fiori diventano lo sfondo dove la ragazza cammina; poi resta la Home.
 * Ogni volta che si apre la Home; mai con "riduci movimento". Senza JavaScript "ENTRA" funziona lo stesso.
 * Unità: 1vh ≈ 2,7 cm (la stanza è alta 100vh). Origine: centro della porta sul pavimento; y verso il basso.
 */

// Fiori del quadro (sempre uguali): bianchi con il cuore dorato, su fondo tortora
let seme = 11;
const caso = () => (seme = (seme * 16807) % 2147483647) / 2147483647;
const fiori = Array.from({ length: 230 }, (_, i) => ({
  v: i % 5, // variante di volo quando si dissolvono
  x: 5 + caso() * 990,
  y: 22 + caso() * 165,
  r: 7 + caso() * 11,
  a: caso() * 72,
}));
const steli = Array.from({ length: 110 }, () => ({ x: 10 + caso() * 980, y: 110 + caso() * 80 }));
---

<div class="porta" data-porta>
  <span id="benvenuta" class="porta__ancora"></span>
  <div class="porta__scena" aria-hidden="true">
    <div class="mondo">
      <!-- corridoio: il muro con il vano della porta -->
      <div class="m muro-fuori muro-fuori--sx"></div>
      <div class="m muro-fuori muro-fuori--dx"></div>
      <div class="m muro-fuori muro-fuori--su"></div>
      <div class="m stipite stipite--sx"></div>
      <div class="m stipite stipite--dx"></div>
      <div class="m stipite stipite--su"></div>

      <!-- la sala d'attesa -->
      <div class="m pav"></div>
      <div class="m soff"><span class="luce"></span></div>
            <div class="m parete-sx"></div>
<div class="m parete-dx">
        <svg class="quadro" viewBox="0 0 1000 210" preserveAspectRatio="none">
          <defs>
            <linearGradient id="st-quadro" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#d4cbb8" />
              <stop offset="0.6" stop-color="#bab19d" />
              <stop offset="1" stop-color="#a8a496" />
            </linearGradient>
          </defs>
          <rect width="1000" height="210" fill="url(#st-quadro)" />
          {steli.map((s) => <line x1={s.x} y1={s.y} x2={s.x + 3} y2="210" stroke="#97978a" stroke-width="1.6" opacity="0.55" />)}
          {
            fiori.map((f) => (
              <g transform={`translate(${f.x.toFixed(1)} ${f.y.toFixed(1)}) rotate(${f.a.toFixed(0)})`}>
                {[0, 72, 144, 216, 288].map((r) => (
                  <ellipse cx="0" cy={(-f.r * 0.55).toFixed(1)} rx={(f.r * 0.42).toFixed(1)} ry={(f.r * 0.6).toFixed(1)} fill="#fbfaf6" transform={`rotate(${r})`} />
                ))}
                <circle r={(f.r * 0.22).toFixed(1)} fill="#c7a24a" />
              </g>
            ))
          }
        </svg>
      </div>
      <div class="m fondo fondo--a"></div>
      <div class="m davanti"></div>
      <!-- quattro sedie sotto il quadro, contro la parete di destra -->
      <div class="sedia sedia--1"><span class="sd-ombra"></span><span class="sd-gamba sd-gamba--1"></span><span class="sd-gamba sd-gamba--2"></span><span class="sd-gamba sd-gamba--3"></span><span class="sd-gamba sd-gamba--4"></span><span class="sd-sopra"></span><span class="sd-fronte"></span><span class="sd-lato sd-lato--sx"></span><span class="sd-lato sd-lato--dx"></span><span class="sd-schienale"></span><span class="sd-schienale-lato sd-schienale-lato--sx"></span><span class="sd-schienale-lato sd-schienale-lato--dx"></span><span class="sd-schienale-cima"></span></div>
        <div class="sedia sedia--2"><span class="sd-ombra"></span><span class="sd-gamba sd-gamba--1"></span><span class="sd-gamba sd-gamba--2"></span><span class="sd-gamba sd-gamba--3"></span><span class="sd-gamba sd-gamba--4"></span><span class="sd-sopra"></span><span class="sd-fronte"></span><span class="sd-lato sd-lato--sx"></span><span class="sd-lato sd-lato--dx"></span><span class="sd-schienale"></span><span class="sd-schienale-lato sd-schienale-lato--sx"></span><span class="sd-schienale-lato sd-schienale-lato--dx"></span><span class="sd-schienale-cima"></span></div>
        <div class="sedia sedia--3"><span class="sd-ombra"></span><span class="sd-gamba sd-gamba--1"></span><span class="sd-gamba sd-gamba--2"></span><span class="sd-gamba sd-gamba--3"></span><span class="sd-gamba sd-gamba--4"></span><span class="sd-sopra"></span><span class="sd-fronte"></span><span class="sd-lato sd-lato--sx"></span><span class="sd-lato sd-lato--dx"></span><span class="sd-schienale"></span><span class="sd-schienale-lato sd-schienale-lato--sx"></span><span class="sd-schienale-lato sd-schienale-lato--dx"></span><span class="sd-schienale-cima"></span></div>
        <div class="sedia sedia--4"><span class="sd-ombra"></span><span class="sd-gamba sd-gamba--1"></span><span class="sd-gamba sd-gamba--2"></span><span class="sd-gamba sd-gamba--3"></span><span class="sd-gamba sd-gamba--4"></span><span class="sd-sopra"></span><span class="sd-fronte"></span><span class="sd-lato sd-lato--sx"></span><span class="sd-lato sd-lato--dx"></span><span class="sd-schienale"></span><span class="sd-schienale-lato sd-schienale-lato--sx"></span><span class="sd-schienale-lato sd-schienale-lato--dx"></span><span class="sd-schienale-cima"></span></div>
        
      <!-- la porta: cardine nell'angolo destro, si apre verso l'interno fino alla parete -->
      <div class="m anta">
        <div class="anta__spessore"></div>
        <div class="anta__venature"></div>
        <div class="targa">
          <span class="vite vite--1"></span><span class="vite vite--2"></span>
          <span class="vite vite--3"></span><span class="vite vite--4"></span>
          <span class="targa__nome">Dott. Konstantinos Martsidis</span>
          <span class="targa__ruolo">Medico Chirurgo</span>
          <span class="targa__righe">Specialista in Ginecologia ed Ostetricia<br />Esperto in Uroginecologia</span>
          <span class="targa__piede"><span>Tel.: 3207903754</span><span>Riceve per appuntamento</span></span>
        </div>
        <div class="maniglia"></div>
      </div>
    </div>
  </div>
  <!-- il quadro a tutto schermo: si entra nei fiori ed è lì che la donna cammina -->
  <svg class="porta__prato" viewBox="0 0 1000 210" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect width="1000" height="210" fill="url(#st-quadro)" />
    {steli.map((s) => <line x1={s.x} y1={s.y} x2={s.x + 3} y2="210" stroke="#97978a" stroke-width="1.6" opacity="0.55" />)}
    {
      fiori.map((f) => (
        <g class={`fiore fiore--${f.v}`} transform={`translate(${f.x.toFixed(1)} ${f.y.toFixed(1)}) rotate(${f.a.toFixed(0)})`}>
          {[0, 72, 144, 216, 288].map((r) => (
            <ellipse cx="0" cy={(-f.r * 0.55).toFixed(1)} rx={(f.r * 0.42).toFixed(1)} ry={(f.r * 0.6).toFixed(1)} fill="#fbfaf6" transform={`rotate(${r})`} />
          ))}
          <circle r={(f.r * 0.22).toFixed(1)} fill="#c7a24a" />
        </g>
      ))
    }
  </svg>
  <a class="porta__entra" href="#benvenuta" data-porta-entra>ENTRA</a>
</div>

<script>
  const porta = document.querySelector<HTMLElement>('[data-porta]');
  if (porta) {
    const w = window as Window & { __portaChiusa?: boolean };
    const html = document.documentElement;
    const salta = () => {
      porta.classList.add('porta--salta');
      w.__portaChiusa = false;
      html.classList.remove('porta-chiusa');
    };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) salta();
    else {
      w.__portaChiusa = true;
      html.classList.add('porta-chiusa'); // niente scroll finché non si entra
      const entra = porta.querySelector<HTMLAnchorElement>('[data-porta-entra]');
      requestAnimationFrame(() => entra?.focus({ preventScroll: true }));
      const apri = (e?: Event) => {
        e?.preventDefault();
        if (porta.classList.contains('porta--aperta')) return;
        porta.classList.add('porta--aperta');
        // la camera è entrata nel quadro: la donna cammina tra i fiori
        setTimeout(() => {
          porta.classList.add('porta--dentro');
          html.classList.remove('porta-chiusa');
          w.__portaChiusa = false;
          window.dispatchEvent(new Event('porta-aperta'));
        }, 4200);
        setTimeout(salta, 6400);
      };
      porta.addEventListener('click', apri);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !porta.classList.contains('porta--aperta')) apri(e);
      });
    }
  }
</script>

<style>
  .porta {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #e9e4dc;
    cursor: pointer;
    overflow: hidden;
  }
  .porta--salta {
    display: none;
  }
  .porta__scena {
    position: absolute;
    inset: 0;
    perspective: 100vh;
    perspective-origin: 50% 50%;
  }
  /* il mondo: un punto al centro dello schermo; la camera è il suo transform (il mondo si muove al contrario) */
  .mondo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    /* primissimo piano sulla targa */
    transform: rotateY(0deg) translate3d(0vh, 50vh, 80vh);
  }
  .porta--aperta .mondo,
  .porta:has(.porta__ancora:target) .mondo {
    animation: camera 4.2s linear forwards;
  }
  /* rotateY(φ) translate3d(-C): C è il punto inquadrato al centro dello schermo, φ quanto si guarda a destra */
  /* un unico movimento, senza soste. Il primo arrivo è l'inquadratura della foto: la porta si apre verso di noi,
     l'anta con la targa a destra in primo piano, nello spiraglio di scorcio la parete di destra con il quadro e le
     sedie. Poi si entra e si va nel quadro. */
  @keyframes camera {
    0% {
      transform: rotateY(0deg) translate3d(0vh, 50vh, 80vh);
      animation-timing-function: cubic-bezier(0.45, 0, 0.75, 0.7);
    }
    30% {
      /* il punto di vista della pianta: fuori, a sinistra della porta, in diagonale verso il quadro */
      transform: rotateY(20deg) translate3d(-10vh, 52vh, 54vh);
      animation-timing-function: linear;
    }
    62% {
      /* nel vano della porta e dentro, verso il quadro */
      transform: rotateY(40deg) translate3d(-59vh, 54vh, 102vh);
      animation-timing-function: cubic-bezier(0.2, 0.4, 0.4, 1);
    }
    100% {
      /* davanti al quadro, così vicini da entrarci */
      transform: rotateY(90deg) translate3d(-53.5vh, 55vh, 74vh);
    }
  }
  .m {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    transform-style: preserve-3d;
  }

  /* — corridoio — */
  .muro-fuori {
    background: linear-gradient(180deg, #ece7df, #e2dcd2);
  }
  .muro-fuori--sx {
    width: 300vh;
    height: 300vh;
    transform: translate3d(-318vh, -200vh, 0.2vh);
  }
  .muro-fuori--dx {
    width: 300vh;
    height: 300vh;
    transform: translate3d(18vh, -200vh, 0.2vh);
  }
  .muro-fuori--su {
    width: 36vh;
    height: 122vh;
    transform: translate3d(-18vh, -200vh, 0.2vh);
  }
  .stipite {
    background: linear-gradient(90deg, #8d5c2e, #a8733f);
  }
  .stipite--sx {
    width: 1.6vh;
    height: 79.6vh;
    transform: translate3d(-18vh, -79.6vh, 0.3vh);
  }
  .stipite--dx {
    width: 1.6vh;
    height: 79.6vh;
    transform: translate3d(16.5vh, -79.6vh, 0.3vh);
  }
  .stipite--su {
    width: 36vh;
    height: 1.6vh;
    transform: translate3d(-18vh, -79.6vh, 0.3vh);
  }

  /* — la sala d'attesa, come nella pianta: la porta è nell'angolo destro (cardine sull'angolo) e si apre verso
     l'interno fino alla parete di destra; subito dopo, sulla stessa parete, il quadro e sotto le sedie.
     Il resto della stanza non si vede. x da -100 a 16.5vh, z da 0 a -160vh, alta 100vh (1vh ≈ 2,7 cm) — */
  .pav {
    width: 116.5vh;
    height: 160vh;
    transform: translate3d(-100vh, 0, 0) rotateX(-90deg);
    background: linear-gradient(180deg, #c7b392, #d6c6aa);
  }
  .soff {
    width: 116.5vh;
    height: 160vh;
    transform: translate3d(-100vh, -100vh, 0) rotateX(-90deg);
    background: #e4e0d9;
  }
  .luce {
    position: absolute;
    left: 55%;
    top: 18%;
    width: 30%;
    height: 40%;
    background: #fff;
    box-shadow: 0 0 6vh 2vh rgb(255 252 235 / 0.9);
  }
  .parete-sx {
    width: 160vh;
    height: 100vh;
    transform: translate3d(-100vh, -100vh, 0) rotateY(90deg);
    background: linear-gradient(90deg, #ebe6de, #e1dbd1);
  }
  .parete-dx {
    width: 160vh;
    height: 100vh;
    transform: translate3d(16.5vh, -100vh, 0) rotateY(90deg);
    background: linear-gradient(90deg, #f6f3ee, #ebe6de);
    box-shadow: inset 0 -2.6vh 0 #d9d2c6;
  }
  /* il quadro sulla parete di destra, subito dopo la porta, sopra le sedie */
  .parete-dx .quadro {
    position: absolute;
    left: 22.5%;
    top: 37%;
    width: 47.5%;
    height: 17%;
    box-shadow: 0 1.2vh 2.4vh rgb(60 50 40 / 0.18);
    outline: 0.3vh solid #a59d8b;
  }
  .fondo {
    height: 100vh;
    background: linear-gradient(180deg, #f2eee8, #e6e1d8);
    box-shadow: inset 0 -2.6vh 0 #d9d2c6;
  }
  .fondo--a {
    width: 116.5vh;
    transform: translate3d(-100vh, -100vh, -160vh);
  }
  .davanti {
    width: 116.5vh;
    height: 100vh;
    transform: translate3d(-100vh, -100vh, -0.1vh);
    background: #e7e2d9;
    clip-path: polygon(0 0, 100% 0, 100% 22%, 71.7% 22%, 71.7% 100%, 0 100%);
  }

  /* — quattro sedie 3D sulla parete di destra, sotto il quadro, girate verso la sala — */
  .sedia {
    --W: 17vh;
    --D: 16vh;
    --H: 17vh;
    --S: 22vh;
  }
  .sedia > span {
    position: absolute;
    display: block;
  }
  .sedia--1 { transform: translate3d(-1.5vh, 0, -112vh) rotateY(-90deg); }
  .sedia--2 { transform: translate3d(-1.5vh, 0, -94vh) rotateY(-90deg); }
  .sedia--3 { transform: translate3d(-1.5vh, 0, -76vh) rotateY(-90deg); }
  .sedia--4 { transform: translate3d(-1.5vh, 0, -58vh) rotateY(-90deg); }
  .sd-ombra {
    left: -3vh;
    top: 0;
    width: calc(var(--W) + 6vh);
    height: calc(var(--D) + 6vh);
    transform-origin: 50% 0;
    transform: translateZ(3vh) rotateX(-90deg);
    background: radial-gradient(closest-side, rgb(60 45 30 / 0.28), transparent);
  }
  .sd-gamba {
    top: calc(var(--H) * -1);
    width: 0.9vh;
    height: var(--H);
    background: linear-gradient(90deg, #3e3a36, #6a645e, #3e3a36);
  }
  .sd-gamba--1 { left: 0.6vh; transform: translateZ(-1vh); }
  .sd-gamba--2 { left: calc(var(--W) - 1.5vh); transform: translateZ(-1vh); }
  .sd-gamba--3 { left: 0.6vh; transform: translateZ(calc(var(--D) * -1 + 1vh)); }
  .sd-gamba--4 { left: calc(var(--W) - 1.5vh); transform: translateZ(calc(var(--D) * -1 + 1vh)); }
  .sd-sopra {
    left: 0;
    top: calc(var(--H) * -1 - 2.4vh);
    width: var(--W);
    height: var(--D);
    transform-origin: 50% 0;
    transform: rotateX(-90deg);
    border-radius: 1.2vh;
    background: linear-gradient(180deg, #8f8981, #a39d95);
  }
  .sd-fronte {
    left: 0;
    top: calc(var(--H) * -1 - 2.4vh);
    width: var(--W);
    height: 2.4vh;
    border-radius: 0 0 0.8vh 0.8vh;
    background: linear-gradient(180deg, #7a746d, #5f5a54);
  }
  .sd-lato {
    top: calc(var(--H) * -1 - 2.4vh);
    width: var(--D);
    height: 2.4vh;
    background: #66605a;
    transform-origin: 0 50%;
  }
  .sd-lato--sx { left: 0; transform: rotateY(90deg); }
  .sd-lato--dx { left: var(--W); transform: rotateY(90deg); }
  .sd-schienale {
    left: 0;
    top: calc(var(--H) * -1 - 2.4vh - var(--S));
    width: var(--W);
    height: var(--S);
    transform-origin: 50% 100%;
    transform: translateZ(calc(var(--D) * -1 + 1.5vh)) rotateX(-7deg);
    border-radius: 2.2vh 2.2vh 0.6vh 0.6vh;
    background:
      repeating-linear-gradient(180deg, transparent 0 4.2vh, rgb(60 55 50 / 0.45) 4.2vh 4.45vh),
      linear-gradient(90deg, #6f6963, #938d86 45%, #6a645e);
    box-shadow: inset 0 -1vh 1.5vh rgb(0 0 0 / 0.15);
  }
  .sd-schienale-lato {
    top: calc(var(--H) * -1 - 2.4vh - var(--S));
    width: 1.8vh;
    height: var(--S);
    background: #5d5852;
    transform-origin: 0 100%;
  }
  .sd-schienale-lato--sx { left: 0; transform: translateZ(calc(var(--D) * -1 + 1.5vh)) rotateX(-7deg) rotateY(90deg); }
  .sd-schienale-lato--dx { left: var(--W); transform: translateZ(calc(var(--D) * -1 + 1.5vh)) rotateX(-7deg) rotateY(90deg); }
  .sd-schienale-cima {
    left: 0;
    top: calc(var(--H) * -1 - 2.4vh - var(--S));
    width: var(--W);
    height: 1.8vh;
    transform-origin: 50% 0;
    transform: translateZ(calc(var(--D) * -1 + 1.5vh)) rotateX(-7deg) rotateX(-90deg);
    border-radius: 1vh;
    background: #7d776f;
  }

  /* — la porta: 90 cm × 210 cm (33 × 78vh), cardine a destra — */
  .anta {
    width: 33vh;
    height: 78vh;
    transform-origin: 100% 50%;
    transform: translate3d(-16.5vh, -78vh, 0);
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.18), transparent 4%, transparent 96%, rgb(0 0 0 / 0.16)),
      linear-gradient(180deg, #cf9a62, #bd8248 55%, #ab713a);
    box-shadow: 0 0 6vh rgb(30 20 10 / 0.25);
  }
  .porta--aperta .anta,
  .porta:has(.porta__ancora:target) .anta {
    animation: porta-apre 2.6s cubic-bezier(0.4, 0, 0.3, 1) forwards;
  }
  @keyframes porta-apre {
    40% {
      transform: translate3d(-16.5vh, -78vh, 0) rotateY(-60deg);
    }
    to {
      /* tutta aperta, appoggiata alla parete di destra */
      transform: translate3d(-16.5vh, -78vh, 0) rotateY(-88deg);
    }
  }
  .anta__spessore {
    position: absolute;
    top: 0;
    left: 0;
    width: 1.5vh;
    height: 100%;
    transform-origin: 0 50%;
    transform: rotateY(90deg);
    background: linear-gradient(90deg, #8a5a2c, #a8733f 40%, #7d5127);
  }
  .anta__venature {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    background: repeating-linear-gradient(
      92deg,
      transparent 0 0.6vh,
      rgb(120 70 30 / 0.25) 0.6vh 0.64vh,
      transparent 0.64vh 1.4vh,
      rgb(255 220 180 / 0.12) 1.4vh 1.44vh
    );
  }
  /* targa: 30 × 22 cm circa, al centro della porta, all'altezza degli occhi */
  .targa {
    position: absolute;
    left: 50%;
    top: 28vh;
    translate: -50% -50%;
    display: grid;
    gap: 0.06vh;
    width: 12.5vh;
    padding: 0.9vh 0.9vh 0.6vh;
    border-radius: 0.1vh;
    background: linear-gradient(135deg, #ecd394, #c9a456 45%, #e8cc87 70%, #b8913f);
    box-shadow: 0 0.4vh 1vh rgb(40 25 5 / 0.4), inset 0 0.04vh 0 rgb(255 255 255 / 0.55);
    color: #3a2a12;
    font-family: Georgia, 'Times New Roman', serif;
    text-align: center;
    line-height: 1.25;
  }
  .vite {
    position: absolute;
    width: 0.32vh;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff6d6, #c9a24c 60%, #8a6a22);
  }
  .vite--1 { top: 0.25vh; left: 0.25vh; }
  .vite--2 { top: 0.25vh; right: 0.25vh; }
  .vite--3 { bottom: 0.25vh; left: 0.25vh; }
  .vite--4 { bottom: 0.25vh; right: 0.25vh; }
  .targa__nome {
    font-size: 0.72vh;
  }
  .targa__ruolo {
    font-size: 0.42vh;
    font-style: italic;
  }
  .targa__righe {
    margin-top: 0.28vh;
    font-size: 0.48vh;
  }
  .targa__piede {
    display: flex;
    justify-content: space-between;
