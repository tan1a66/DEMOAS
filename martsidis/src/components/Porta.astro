---
/**
 * Entrata del sito: la porta dello studio si apre e dietro c'è la Home, con la donna che entra camminando.
 * - Se esiste src/assets/foto/porta.jpg (la foto della porta dello studio) l'anta usa quella foto;
 *   altrimenti è una porta disegnata, in legno, con la targa in ottone.
 * - Resta chiusa finché non si tocca "Entra" (o la porta): poi si apre piano.
 * - Una volta per visita (sessionStorage), mai con "riduci movimento".
 * - Funziona anche senza JavaScript: "Entra" è un link e l'apertura è solo CSS (:target).
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { sito } from '@/data/sito';

const foto = import.meta.glob<{ default: ImageMetadata }>('/src/assets/foto/porta.{jpg,jpeg,png,webp}', { eager: true });
const sorgente = Object.values(foto)[0]?.default;
const img = sorgente ? await getImage({ src: sorgente, width: 1600, format: 'webp' }) : null;
---

<div class:list={['porta', { 'porta--foto': img }]} data-porta>
  <span id="benvenuta" class="porta__ancora"></span>
  <div class="porta__anta" aria-hidden="true">
    {
      img ? (
        <>
          <img class="porta__sfondo" src={img.src} alt="" />
          <img class="porta__foto" src={img.src} alt="" width={img.attributes.width} height={img.attributes.height} />
        </>
      ) : (
        <>
          <div class="porta__venature" />
          <div class="porta__targa">
            <span class="porta__nome">{sito.nome}</span>
            <span class="porta__ruolo">Ginecologia · Ostetricia · Uroginecologia</span>
            <span class="porta__riceve">Riceve per appuntamento</span>
          </div>
          <div class="porta__pomello" />
        </>
      )
    }
  </div>
  <a class="porta__entra" href="#benvenuta" data-porta-entra>Entra</a>
</div>

<script>
  const porta = document.querySelector<HTMLElement>('[data-porta]');
  if (porta) {
    let vista = false;
    try {
      vista = sessionStorage.getItem('porta-vista') === '1';
    } catch {
      /* navigazione privata */
    }
    const w = window as Window & { __portaChiusa?: boolean };
    const salta = () => {
      porta.classList.add('porta--salta');
      w.__portaChiusa = false;
    };
    if (vista || matchMedia('(prefers-reduced-motion: reduce)').matches) salta();
    else {
      w.__portaChiusa = true;
      document.documentElement.classList.add('porta-chiusa'); // niente scroll finché non si entra
      const entra = porta.querySelector<HTMLAnchorElement>('[data-porta-entra]');
      requestAnimationFrame(() => entra?.focus({ preventScroll: true }));
      const apri = (e?: Event) => {
        e?.preventDefault();
        if (porta.classList.contains('porta--aperta')) return;
        porta.classList.add('porta--aperta');
        try {
          sessionStorage.setItem('porta-vista', '1');
        } catch {
          /* ok */
        }
        // la donna comincia a entrare mentre la porta finisce di aprirsi
        setTimeout(() => {
          w.__portaChiusa = false;
          document.documentElement.classList.remove('porta-chiusa');
          window.dispatchEvent(new Event('porta-aperta'));
        }, 1300);
      };
      porta.addEventListener('click', apri);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') apri(e);
      });
      porta.addEventListener('animationend', (e) => {
        if (e.animationName.includes('porta-via')) salta();
      });
    }
  }
</script>

<style>
  .porta {
    position: fixed;
    inset: 0;
    z-index: 100;
    perspective: 1800px;
    perspective-origin: 0% 50%;
    background: transparent;
    cursor: pointer;
  }
  .porta--salta {
    display: none;
  }
  .porta__anta {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform-origin: 0% 50%;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.18), transparent 3%, transparent 97%, rgb(0 0 0 / 0.2)),
      linear-gradient(180deg, #c58f5c, #b07a49 55%, #a06b3d);
    box-shadow: 0 0 80px rgb(30 20 10 / 0.35);
    will-change: transform;
  }
  /* l'anta, aprendosi, si scurisce appena (prende meno luce) */
  .porta__anta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(20 12 6);
    opacity: 0;
  }
  /* si apre piano, solo dopo "Entra" */
  .porta--aperta {
    animation: porta-via 0.01s linear 3s forwards;
  }
  /* senza JavaScript: appena si entra la porta non blocca più nulla (l'anta aperta è di taglio, invisibile) */
  .porta:has(.porta__ancora:target) {
    pointer-events: none;
  }
  .porta--aperta .porta__anta,
  .porta:has(.porta__ancora:target) .porta__anta {
    animation: porta-apre 2.6s cubic-bezier(0.55, 0, 0.2, 1) forwards;
  }
  .porta--aperta .porta__anta::after,
  .porta:has(.porta__ancora:target) .porta__anta::after {
    animation: porta-ombra 2.6s cubic-bezier(0.55, 0, 0.2, 1) forwards;
  }
  .porta--aperta .porta__entra,
  .porta:has(.porta__ancora:target) .porta__entra {
    opacity: 0;
    transition: opacity 0.4s;
  }
  .porta__entra {
    position: absolute;
    left: 50%;
    bottom: max(12vh, 5rem);
    translate: -50% 0;
    z-index: 2;
    padding: 0.95rem 2.6rem;
    border-radius: 999px;
    border: 1px solid rgb(255 240 200 / 0.75);
    background: rgb(45 30 60 / 0.82);
    backdrop-filter: blur(6px);
    color: #fff6dc;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    box-shadow: 0 10px 30px rgb(30 20 10 / 0.35);
    animation: entra-respira 2.4s ease-in-out infinite;
  }
  .porta__entra:hover,
  .porta__entra:focus-visible {
    background: rgb(45 30 60 / 0.95);
    outline: 2px solid #fff6dc;
    outline-offset: 4px;
  }
  @keyframes entra-respira {
    50% {
      box-shadow: 0 10px 30px rgb(30 20 10 / 0.35), 0 0 0 10px rgb(255 240 200 / 0.12);
    }
  }
  .porta__ancora {
    position: absolute;
    top: 0;
  }
  :global(html.porta-chiusa) {
    overflow: hidden;
  }
  .porta__foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 45%;
  }
  .porta__sfondo {
    position: absolute;
    inset: -40px;
    width: calc(100% + 80px);
    height: calc(100% + 80px);
    object-fit: cover;
    filter: blur(28px) brightness(0.85);
  }
  .porta__foto {
    position: relative;
  }
  @media (min-aspect-ratio: 4/5) {
    /* schermo largo: la foto (verticale) si vede tutta, al centro, su uno sfondo sfocato della stessa foto */
    .porta__foto {
      object-fit: contain;
      object-position: 50% 50%;
    }
    .porta--foto .porta__anta {
      transform-origin: 42% 62%;
    }
  }
  /* con la foto vera (la porta è già socchiusa): dopo "Entra" si entra nella sala, verso le sedie */
  .porta--foto .porta__anta {
    background: #2a2118;
    transform-origin: 30% 62%;
    box-shadow: none;
  }
  .porta--foto.porta--aperta .porta__anta,
  .porta--foto:has(.porta__ancora:target) .porta__anta {
    animation: porta-entra 2.6s cubic-bezier(0.55, 0, 0.2, 1) forwards;
  }
  .porta--foto .porta__anta::after {
    display: none;
  }
  @keyframes porta-entra {
    55% {
      opacity: 1;
    }
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }
  .porta__venature {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    background: repeating-linear-gradient(
      92deg,
      transparent 0 18px,
      rgb(120 70 30 / 0.25) 18px 19px,
      transparent 19px 41px,
      rgb(255 220 180 / 0.12) 41px 42px
    );
  }
  .porta__targa {
    position: absolute;
    top: 22%;
    right: 9%;
    display: grid;
    gap: 0.35rem;
    width: min(26rem, 70vw);
    padding: clamp(1rem, 3vw, 1.75rem);
    border-radius: 3px;
    background: linear-gradient(135deg, #e9cf8e, #c9a456 45%, #e6c983 70%, #b8913f);
    box-shadow: 0 6px 18px rgb(40 25 5 / 0.35), inset 0 1px 0 rgb(255 255 255 / 0.5);
    color: #3a2a12;
    font-family: var(--font-heading);
    text-align: center;
  }
  .porta__nome {
    font-size: clamp(1.1rem, 0.8rem + 1.6vw, 1.7rem);
  }
  .porta__ruolo {
    font-size: clamp(0.8rem, 0.7rem + 0.5vw, 1rem);
    font-style: italic;
  }
  .porta__riceve {
    margin-top: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }
  .porta__pomello {
    position: absolute;
    top: 56%;
    right: 7%;
    width: clamp(2.8rem, 6vw, 4rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff3c8, #d6b25e 40%, #8f6a22 85%);
    box-shadow: 0 8px 16px rgb(40 25 5 / 0.45);
  }
  @keyframes porta-apre {
    to {
      transform: rotateY(-104deg);
    }
  }
  @keyframes porta-ombra {
    to {
      opacity: 0.45;
    }
  }
  @keyframes porta-via {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .porta {
      display: none;
    }
  }
</style>
