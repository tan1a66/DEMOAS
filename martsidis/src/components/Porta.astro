---
/**
 * Entrata del sito:
 * 1. la porta dello studio è chiusa (legno e targa in ottone con le stesse diciture di quella vera)
 *    con il pulsante "Entra";
 * 2. toccando "Entra" la porta si apre e si intravede lo studio (disegnato: pareti chiare, il quadro
 *    con i fiori bianchi, le due sedie grigie);
 * 3. subito dopo la donna entra camminando nella Home.
 * Una volta per visita (sessionStorage), mai con "riduci movimento". Senza JavaScript "Entra" è un link
 * e l'apertura è solo CSS (:target).
 */

// Fiori del quadro (disegnati, sempre uguali): bianchi su fondo tortora, come nella sala d'attesa
let seme = 11;
const caso = () => (seme = (seme * 16807) % 2147483647) / 2147483647;
const fiori = Array.from({ length: 70 }, () => ({
  x: 140 + caso() * 600,
  y: 225 + caso() * 115,
  r: 7 + caso() * 9,
  a: caso() * 72,
}));
const steli = Array.from({ length: 45 }, () => ({ x: 140 + caso() * 600, y: 300 + caso() * 60 }));
---


<div class="porta" data-porta>
  <span id="benvenuta" class="porta__ancora"></span>
  <svg class="porta__studio" viewBox="0 0 1000 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="studio-muro" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ece9e3" />
        <stop offset="0.85" stop-color="#f6f3ee" />
      </linearGradient>
      <linearGradient id="studio-quadro" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#cfc6b3" />
        <stop offset="0.6" stop-color="#b9b09c" />
        <stop offset="1" stop-color="#a9a597" />
      </linearGradient>
      <linearGradient id="studio-sedia" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#77716b" />
        <stop offset="0.5" stop-color="#8d8780" />
        <stop offset="1" stop-color="#6f6963" />
      </linearGradient>
    </defs>
    <rect width="1000" height="700" fill="url(#studio-muro)" />
    <rect width="1000" height="70" fill="#e4e1db" />
    <rect x="40" y="18" width="380" height="22" rx="3" fill="#ffffff" />
    <rect x="40" y="18" width="380" height="22" rx="3" fill="#fffbe8" opacity="0.6" />
    <rect x="0" y="640" width="1000" height="60" fill="#dcd2c3" />
    <rect x="128" y="212" width="624" height="150" fill="url(#studio-quadro)" />
    {steli.map((s) => <line x1={s.x} y1={s.y} x2={s.x + 2} y2={362} stroke="#9a9a8c" stroke-width="1.2" opacity="0.6" />)}
    {
      fiori.map((f) => (
        <g transform={`translate(${f.x.toFixed(1)} ${f.y.toFixed(1)}) rotate(${f.a.toFixed(0)})`}>
          {[0, 72, 144, 216, 288].map((r) => (
            <ellipse cx="0" cy={(-f.r * 0.55).toFixed(1)} rx={(f.r * 0.42).toFixed(1)} ry={(f.r * 0.6).toFixed(1)} fill="#fbfaf6" transform={`rotate(${r})`} />
          ))}
          <circle r={(f.r * 0.22).toFixed(1)} fill="#c7a24a" />
        </g>
      ))
    }
    <rect x="128" y="212" width="624" height="150" fill="none" stroke="#a49d8c" stroke-width="2" />
    <!-- tavolino a sinistra -->
    <rect x="-20" y="520" width="120" height="14" fill="#fbfbfa" />
    <rect x="70" y="534" width="6" height="106" fill="#e7e5e1" />
    <!-- due sedie -->
    {
      [250, 440].map((x) => (
        <g>
          <rect x={x} y="440" width="130" height="150" rx="16" fill="url(#studio-sedia)" />
          {[470, 500, 530, 560].map((y) => <line x1={x + 10} y1={y} x2={x + 120} y2={y} stroke="#5f5a55" stroke-width="2" opacity="0.5" />)}
          <rect x={x - 10} y="585" width="150" height="26" rx="8" fill="#7d7771" />
          <rect x={x} y="611" width="6" height="60" fill="#55504b" />
          <rect x={x + 124} y="611" width="6" height="60" fill="#55504b" />
        </g>
      ))
    }
  </svg>
  <div class="porta__anta" aria-hidden="true">
    <div class="porta__venature"></div>
    <div class="porta__targa">
      <span class="porta__nome">Dott. Konstantinos Martsidis</span>
      <span class="porta__ruolo">Medico Chirurgo</span>
      <span class="porta__righe">Specialista in Ginecologia ed Ostetricia<br />Esperto in Uroginecologia</span>
      <span class="porta__piede"><span>Tel.: 3207903754</span><span>Riceve per appuntamento</span></span>
    </div>
    <div class="porta__pomello"></div>
  </div>
  <a class="porta__entra" href="#benvenuta" data-porta-entra>Entra</a>
</div>

<script>
  const porta = document.querySelector<HTMLElement>('[data-porta]');
  if (porta) {
    let vista = false;
    try {
      vista = sessionStorage.getItem('porta-vista') === '1';
    } catch {
      /* navigazione privata */
    }
    const w = window as Window & { __portaChiusa?: boolean };
    const salta = () => {
      porta.classList.add('porta--salta');
      w.__portaChiusa = false;
      document.documentElement.classList.remove('porta-chiusa');
    };
    if (vista || matchMedia('(prefers-reduced-motion: reduce)').matches) salta();
    else {
      w.__portaChiusa = true;
      document.documentElement.classList.add('porta-chiusa'); // niente scroll finché non si entra
      const entra = porta.querySelector<HTMLAnchorElement>('[data-porta-entra]');
      requestAnimationFrame(() => entra?.focus({ preventScroll: true }));
      const apri = (e?: Event) => {
        e?.preventDefault();
        if (porta.classList.contains('porta--aperta')) return;
        porta.classList.add('porta--aperta');
        try {
          sessionStorage.setItem('porta-vista', '1');
        } catch {
          /* ok */
        }
        // la porta è aperta e si è intravisto lo studio: subito la donna che cammina
        setTimeout(() => {
          porta.classList.add('porta--dentro');
          w.__portaChiusa = false;
          document.documentElement.classList.remove('porta-chiusa');
          window.dispatchEvent(new Event('porta-aperta'));
        }, 2300);
        setTimeout(salta, 3100);
      };
      porta.addEventListener('click', apri);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !porta.classList.contains('porta--aperta')) apri(e);
      });
    }
  }
</script>

<style>
  .porta {
    position: fixed;
    inset: 0;
    z-index: 100;
    perspective: 1800px;
    perspective-origin: 0% 50%;
    background: #2a2118;
    cursor: pointer;
  }
  .porta--salta {
    display: none;
  }

  /* — lo studio, dietro la porta — */
  .porta__studio {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform-origin: 45% 55%;
    transition:
      transform 2.4s cubic-bezier(0.45, 0, 0.2, 1),
      opacity 0.7s ease;
  }
  .porta--aperta .porta__studio {
    transform: scale(1.1);
  }
  /* subito dopo: lo studio lascia il posto alla Home, dove entra la donna */
  .porta--dentro {
    pointer-events: none;
    background: transparent;
  }
  .porta--dentro .porta__studio {
    opacity: 0;
  }

  /* — la porta chiusa — */
  .porta__anta {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform-origin: 0% 50%;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.22), transparent 3%, transparent 97%, rgb(0 0 0 / 0.25)),
      linear-gradient(180deg, #cf9a62, #bd8248 55%, #ab713a);
    box-shadow: 0 0 80px rgb(30 20 10 / 0.35);
    will-change: transform;
  }
  .porta__anta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(20 12 6);
    opacity: 0;
  }
  .porta--aperta .porta__anta,
  .porta:has(.porta__ancora:target) .porta__anta {
    animation: porta-apre 2.2s cubic-bezier(0.55, 0, 0.2, 1) forwards;
  }
  .porta--aperta .porta__anta::after,
  .porta:has(.porta__ancora:target) .porta__anta::after {
    animation: porta-ombra 2.2s cubic-bezier(0.55, 0, 0.2, 1) forwards;
  }
  .porta--dentro .porta__anta {
    visibility: hidden;
  }
  /* senza JavaScript: appena si entra la porta non blocca più nulla e lo studio sfuma */
  .porta:has(.porta__ancora:target) {
    pointer-events: none;
    background: transparent;
  }
  .porta:has(.porta__ancora:target) .porta__studio {
    animation: studio-via 0.7s ease 2.3s forwards;
  }
  .porta__venature {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    background: repeating-linear-gradient(
      92deg,
      transparent 0 18px,
      rgb(120 70 30 / 0.25) 18px 19px,
      transparent 19px 41px,
      rgb(255 220 180 / 0.12) 41px 42px
    );
  }
  .porta__targa {
    position: absolute;
    top: 16%;
    right: 8%;
    display: grid;
    gap: 0.3rem;
    width: min(26rem, 72vw);
    padding: clamp(1rem, 3vw, 1.75rem) clamp(1rem, 3vw, 2rem);
    border-radius: 3px;
    background: linear-gradient(135deg, #e9cf8e, #c9a456 45%, #e6c983 70%, #b8913f);
    box-shadow: 0 6px 18px rgb(40 25 5 / 0.35), inset 0 1px 0 rgb(255 255 255 / 0.5);
    color: #3a2a12;
    font-family: Georgia, 'Times New Roman', serif;
    text-align: center;
  }
  .porta__nome {
    font-size: clamp(1.05rem, 0.8rem + 1.4vw, 1.6rem);
  }
  .porta__ruolo {
    font-size: clamp(0.75rem, 0.65rem + 0.4vw, 0.95rem);
    font-style: italic;
  }
  .porta__righe {
    margin-top: 0.5rem;
    font-size: clamp(0.85rem, 0.7rem + 0.6vw, 1.1rem);
    line-height: 1.35;
  }
  .porta__piede {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
    font-size: clamp(0.7rem, 0.62rem + 0.35vw, 0.88rem);
  }
  .porta__pomello {
    position: absolute;
    top: 58%;
    right: 7%;
    width: clamp(2.8rem, 6vw, 4rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff3c8, #d6b25e 40%, #8f6a22 85%);
    box-shadow: 0 8px 16px rgb(40 25 5 / 0.45);
  }

  /* — "Entra" — */
  .porta__entra {
    position: absolute;
    left: 50%;
    bottom: max(12vh, 5rem);
    translate: -50% 0;
    z-index: 2;
    padding: 0.95rem 2.6rem;
    border-radius: 999px;
    border: 1px solid rgb(255 240 200 / 0.75);
    background: rgb(45 30 60 / 0.82);
    backdrop-filter: blur(6px);
    color: #fff6dc;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    box-shadow: 0 10px 30px rgb(30 20 10 / 0.35);
    animation: entra-respira 2.4s ease-in-out infinite;
  }
  .porta__entra:hover,
  .porta__entra:focus-visible {
    background: rgb(45 30 60 / 0.95);
    outline: 2px solid #fff6dc;
    outline-offset: 4px;
  }
  .porta--aperta .porta__entra,
  .porta:has(.porta__ancora:target) .porta__entra {
    opacity: 0;
    transition: opacity 0.4s;
  }
  .porta__ancora {
    position: absolute;
    top: 0;
  }
  :global(html.porta-chiusa) {
    overflow: hidden;
  }
  @keyframes entra-respira {
    50% {
      box-shadow: 0 10px 30px rgb(30 20 10 / 0.35), 0 0 0 10px rgb(255 240 200 / 0.12);
    }
  }
  @keyframes porta-apre {
    to {
      transform: rotateY(-104deg);
    }
  }
  @keyframes porta-ombra {
    to {
      opacity: 0.45;
    }
  }
  @keyframes studio-via {
    to {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .porta {
      display: none;
    }
  }
</style>
