---
/** Barra fissa in basso, solo su mobile/tablet: "Prenota una visita" sempre a un tocco (apre la scelta). */
import Icon from './Icon.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations();
---

<nav class="contactbar no-print" aria-label={t('a11y.contactbar')}>
  <a class="contactbar__btn" href="/prenota-una-visita/" data-prenota>
    <Icon name="calendar-check" size={22} />
    <span>{t('cta.book')}</span>
  </a>
</nav>

<style>
  .contactbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    padding: var(--space-2) var(--space-3) calc(var(--space-2) + env(safe-area-inset-bottom, 0px));
    background: rgb(251 248 243 / 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -6px 20px rgb(45 30 60 / 0.08);
  }
  @media (min-width: 64rem) {
    .contactbar {
      display: none;
    }
  }
  .contactbar__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55em;
    min-height: 3.25rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-weight: 700;
    font-size: 1.0625rem;
    text-decoration: none;
  }
  .contactbar__btn:hover {
    color: var(--color-on-primary);
    background: var(--color-primary-hover);
  }
</style>
