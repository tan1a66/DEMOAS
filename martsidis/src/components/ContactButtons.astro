---
/** Pulsante "Prenota una visita": apre la scelta tra WhatsApp, telefono e MioDottore (PrenotaDialog). */
import Button from './Button.astro';
import { useTranslations } from '@/i18n';

interface Props {
  size?: 'md' | 'lg';
  /** 'light' per gli sfondi scuri */
  secondary?: 'secondary' | 'light';
  align?: 'start' | 'center';
}

const { size = 'lg', secondary = 'secondary', align = 'start' } = Astro.props;
const t = useTranslations();
---

<div class:list={['contact-buttons', `contact-buttons--${align}`]}>
  <Button
    href="/prenota-una-visita/"
    size={size}
    icon="calendar-check"
    variant={secondary === 'light' ? 'light' : 'primary'}
    data-prenota
  >
    {t('cta.book')}
  </Button>
</div>

<style>
  .contact-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .contact-buttons--center {
    justify-content: center;
  }
</style>
