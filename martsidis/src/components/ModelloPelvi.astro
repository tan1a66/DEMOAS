---
/**
 * Il pavimento pelvico, spiegato: modello 3D interattivo con 4 stati.
 * - Deep link: /#normale, /#incontinenza, /#prolasso, /#riabilitazione (apre lo stato e scorre qui).
 * - Accessibilità: pulsanti con aria-pressed, testo dello stato in una regione aria-live,
 *   descrizione testuale completa, comandi da tastiera sul modello, nota "rappresentazione semplificata".
 * - Senza WebGL / con "riduci movimento" si vede la versione SVG, con gli stessi stati.
 */
import ThreeIsland from './ThreeIsland.astro';
import PelviSvg from './PelviSvg.astro';
import Icon from './Icon.astro';
import { STATI, STATO_INIZIALE, statoPerId } from '@/three/pelvi/stati';
import { useTranslations } from '@/i18n';

const t = useTranslations();
const iniziale = statoPerId(STATO_INIZIALE);
---

<div class="pelvi" data-pelvi data-stato={iniziale.id}>
  {STATI.map((s) => <span id={s.id} class="pelvi__ancora" />)}
  <div class="pelvi__griglia">
    <div class="pelvi__vista">
      <ThreeIsland scena="pelvi" class="pelvi__island">
        <PelviSvg />
      </ThreeIsland>
      <div class="pelvi__comandi" data-solo-3d hidden>
        <p class="pelvi__aiuto" id="pelvi-aiuto">
          <span class="pelvi__aiuto-mouse">Trascini per ruotare. Con la tastiera: frecce per ruotare, + e − per lo zoom.</span>
          <span class="pelvi__aiuto-touch">Scorra di lato con il dito per ruotare il modello.</span>
        </p>
        <div class="pelvi__bottoni">
          <button type="button" class="pelvi__btn pelvi__btn--zoom" data-comando="zoom-" aria-label="Allontana">−</button>
          <button type="button" class="pelvi__btn pelvi__btn--zoom" data-comando="zoom+" aria-label="Avvicina">+</button>
          <button type="button" class="pelvi__btn" data-comando="reimposta">Vista iniziale</button>
        </div>
      </div>
      <p class="pelvi__nota"><Icon name="info" size={18} /> {t('note.modello')}</p>
    </div>

    <div class="pelvi__pannello">
      <div class="pelvi__stati" role="group" aria-label="Scelga cosa vedere nel modello">
        {
          STATI.map((s, i) => (
            <button
              type="button"
              class="pelvi__stato"
              data-stato-btn={s.id}
              aria-pressed={s.id === iniziale.id ? 'true' : 'false'}
              aria-controls="pelvi-testo"
            >
              <span class="pelvi__num" aria-hidden="true">
                {i + 1}
              </span>
              {s.etichetta}
            </button>
          ))
        }
      </div>

      <div class="pelvi__testo" id="pelvi-testo" aria-live="polite" data-testo-live>
        <h3>{iniziale.titolo}</h3>
        <p>{iniziale.testo}</p>
      </div>

      <!-- Testi sorgente degli stati (copiati nella regione aria-live al cambio di stato) -->
      {
        STATI.map((s) => (
          <template data-testo-src={s.id}>
            <h3>{s.titolo}</h3>
            <p>{s.testo}</p>
            {s.link && (
              <p class="pelvi__link">
                <a href={s.link.href}>Approfondisca: {s.link.label}</a>
              </p>
            )}
          </template>
        ))
      }

      <details class="pelvi__descrizione">
        <summary>Descrizione testuale del modello</summary>
        <p>
          Il modello mostra in modo semplificato il bacino di una donna, visto un po’ di lato: davanti la pancia, dietro
          la schiena. In basso c’è il pavimento pelvico, disegnato come un’amaca viola. Sopra l’amaca, da davanti a
          dietro, ci sono la vescica, l’utero e il retto. I pulsanti mostrano quattro situazioni:
        </p>
        <dl>
          {
            STATI.map((s) => (
              <>
                <dt>{s.etichetta}</dt>
                <dd>
                  {s.descrizione} {s.testo}
                </dd>
              </>
            ))
          }
        </dl>
      </details>
    </div>
  </div>
</div>

<script>
  import { isIdStato, type IdStato } from '../three/pelvi/stati';

  document.querySelectorAll<HTMLElement>('[data-pelvi]').forEach((radice) => {
    const pulsanti = radice.querySelectorAll<HTMLButtonElement>('[data-stato-btn]');
    const live = radice.querySelector<HTMLElement>('[data-testo-live]');
    const isola = radice.querySelector<HTMLElement>('three-island');
    const etichette = Object.fromEntries([...pulsanti].map((b) => [b.dataset.statoBtn, b.textContent?.trim() ?? '']));

    const aggiornaEtichettaModello = (id: string) => {
      if (isola && radice.classList.contains('is-3d')) {
        isola.setAttribute('aria-label', `Modello 3D del pavimento pelvico. Situazione mostrata: ${etichette[id]?.replace(/^\d+\s*/, '')}.`);
      }
    };

    const imposta = (id: IdStato, { annuncia = true } = {}) => {
      radice.dataset.stato = id;
      pulsanti.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.statoBtn === id)));
      const sorgente = radice.querySelector<HTMLTemplateElement>(`template[data-testo-src="${id}"]`);
      if (live && sorgente) {
        if (!annuncia) live.removeAttribute('aria-live');
        live.replaceChildren(sorgente.content.cloneNode(true));
        if (!annuncia) requestAnimationFrame(() => live.setAttribute('aria-live', 'polite'));
      }
      aggiornaEtichettaModello(id);
      radice.dispatchEvent(new CustomEvent('pelvi:stato', { detail: id }));
    };

    pulsanti.forEach((b) =>
      b.addEventListener('click', () => {
        const id = b.dataset.statoBtn ?? '';
        if (!isIdStato(id)) return;
        imposta(id);
        history.replaceState(null, '', `#${id}`);
      }),
    );

    radice.querySelectorAll<HTMLButtonElement>('[data-comando]').forEach((b) =>
      b.addEventListener('click', () =>
        radice.dispatchEvent(new CustomEvent('pelvi:comando', { detail: b.dataset.comando })),
      ),
    );

    // Deep link (/#prolasso…): all'apertura e quando cambia l'hash
    const daHash = (annuncia: boolean) => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (isIdStato(id)) imposta(id, { annuncia });
    };
    daHash(false);
    window.addEventListener('hashchange', () => daHash(true));

    // Quando il 3D è pronto: il modello diventa focalizzabile e compaiono i comandi
    radice.addEventListener('three:pronto', () => {
      radice.classList.add('is-3d');
      radice.querySelectorAll<HTMLElement>('[data-solo-3d]').forEach((el) => (el.hidden = false));
      if (isola) {
        isola.tabIndex = 0;
        isola.setAttribute('role', 'group');
        isola.setAttribute('aria-roledescription', 'modello 3D interattivo');
        isola.setAttribute('aria-describedby', 'pelvi-aiuto');
        aggiornaEtichettaModello(radice.dataset.stato ?? 'normale');
      }
    });
  });
</script>

<style>
  .pelvi {
    position: relative;
  }
  .pelvi__ancora {
    position: absolute;
    top: calc(-1 * var(--space-9));
  }
  .pelvi__griglia {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 64rem) {
    .pelvi__griglia {
      grid-template-columns: 1.35fr 1fr;
      gap: var(--space-7);
    }
  }

  .pelvi__vista {
    position: relative;
  }
  .pelvi__vista :global(.pelvi__island) {
    aspect-ratio: 4 / 3.4;
    width: 100%;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(70% 60% at 50% 45%, var(--c-white), transparent 75%),
      linear-gradient(180deg, var(--c-plum-50), var(--c-sand-50));
    border: 1px solid var(--color-border-soft);
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  @media (max-width: 40rem) {
    .pelvi__vista :global(.pelvi__island) {
      aspect-ratio: 1 / 1.08;
    }
    .pelvi__vista :global(.pelvi-etichetta) {
      font-size: 0.75rem;
      padding: 0.1rem 0.45rem;
    }
    .pelvi__vista :global(.pelvi-etichetta--bacino) {
      display: none;
    }
  }
  .pelvi__vista :global(.three-island__fallback) {
    padding: 6% 4% 4%;
  }
  .pelvi__vista :global(three-island[data-stato='pronto']) {
    cursor: grab;
  }
  .pelvi__vista :global(three-island.is-trascinando) {
    cursor: grabbing;
  }

  /* Etichette HTML posizionate dal codice 3D */
  .pelvi__vista :global(.pelvi-etichette) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .pelvi__vista :global(.pelvi-etichetta) {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -100%;
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.88);
    border: 1px solid var(--color-border-soft);
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--c-ink);
    white-space: nowrap;
    box-shadow: var(--shadow-sm);
    transition: opacity 400ms var(--ease);
  }
  .pelvi__vista :global(.pelvi-etichetta--pressione) {
    background: var(--c-plum-700);
    color: var(--c-white);
    border-color: transparent;
  }

  .pelvi__comandi {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .pelvi__aiuto {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }
  .pelvi__aiuto-touch {
    display: none;
  }
  .pelvi__bottoni {
    display: flex;
    gap: var(--space-2);
  }
  .pelvi__btn {
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0.3rem 0.9rem;
    border: 1.5px solid var(--c-plum-300);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-primary);
    font-weight: 650;
    font-size: 1rem;
    cursor: pointer;
  }
  .pelvi__btn--zoom {
    font-size: 1.35rem;
    line-height: 1;
    padding: 0;
  }
  .pelvi__btn:hover {
    border-color: var(--color-primary);
    background: var(--c-plum-50);
  }
  /* Niente zoom su mobile/touch (non deve intrappolare lo scroll) */
  @media (max-width: 63.99rem), (pointer: coarse) {
    .pelvi__btn--zoom {
      display: none;
    }
    .pelvi__aiuto-mouse {
      display: none;
    }
    .pelvi__aiuto-touch {
      display: inline;
    }
  }

  .pelvi__nota {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: var(--space-3) 0 0;
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .pelvi__stati {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .pelvi__stato {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3.25rem;
    padding: 0.5rem 0.85rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.25;
    text-align: left;
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }
  .pelvi__stato:hover {
    border-color: var(--c-plum-300);
  }
  .pelvi__stato[aria-pressed='true'] {
    border-color: var(--color-primary);
    background: var(--c-plum-50);
    color: var(--c-plum-900);
  }
  .pelvi__num {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--c-sand-100);
    font-size: 0.9rem;
  }
  .pelvi__stato[aria-pressed='true'] .pelvi__num {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .pelvi__testo {
    min-height: 12.5rem;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border-soft);
  }
  .pelvi__testo :global(h3) {
    margin-bottom: var(--space-2);
  }
  .pelvi__testo :global(p:last-child) {
    margin-bottom: 0;
  }
  .pelvi__testo :global(.pelvi__link a) {
    font-weight: 650;
  }

  .pelvi__descrizione {
    margin-top: var(--space-4);
  }
  .pelvi__descrizione summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--color-link);
    font-weight: 600;
    cursor: pointer;
  }
  .pelvi__descrizione dl {
    margin: 0;
  }
  .pelvi__descrizione dt {
    font-weight: 700;
    margin-top: var(--space-3);
  }
  .pelvi__descrizione dd {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
