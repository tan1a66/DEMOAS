---
/**
 * Versione statica (SVG) del modello del pavimento pelvico: vista laterale schematica,
 * davanti (pancia) a sinistra. Stessi 4 stati del 3D, scelti dall'attributo data-stato
 * del contenitore [data-pelvi]. Si vede senza WebGL, con "riduci movimento" o con ?no3d.
 * Il significato è descritto a parole accanto (testo dello stato + descrizione completa).
 */
// Amaca: dal pube (sinistra) al coccige (destra); il punto di controllo scende quando cede.
const amaca = (ctrlY: number) => `M100 258 Q196 ${ctrlY} 290 268`;
---

<svg class="pelvi-svg" viewBox="0 0 400 340" role="presentation" aria-hidden="true" focusable="false">
  <defs>
    <marker id="ps-punta" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" fill="context-stroke"></path>
    </marker>
  </defs>

  {/* Ossa: sacro e coccige (dietro), pube (davanti) */}
  <path d="M318 48C352 100 356 178 322 236C312 252 300 262 288 268" fill="none" stroke="var(--c-sand-200)" stroke-width="22" stroke-linecap="round"></path>
  <ellipse cx="92" cy="236" rx="15" ry="28" transform="rotate(-18 92 236)" fill="var(--c-sand-200)"></ellipse>

  {/* Retto */}
  <path data-parte="retto" d="M300 72C300 140 292 200 268 246L262 300" fill="none" stroke="#d9b590" stroke-width="26" stroke-linecap="round"></path>

  {/* Vagina (fissa) */}
  <path d="M250 222L205 302" fill="none" stroke="#b79acb" stroke-width="15" stroke-linecap="round" opacity="0.85"></path>

  {/* Utero */}
  <g data-parte="utero">
    <path
      transform="translate(222 168) rotate(-32)"
      d="M0-58C34-58 42-20 34 4C26 26 12 40 10 60L-10 60C-12 40-26 26-34 4C-42-20-34-58 0-58Z"
      fill="#c7aedb"></path>
  </g>

  {/* Vescica e uretra */}
  <g data-parte="vescica">
    <circle cx="150" cy="204" r="40" fill="#9cb9a6"></circle>
    <path d="M150 243L140 300" fill="none" stroke="#9cb9a6" stroke-width="9" stroke-linecap="round"></path>
  </g>

  {/* Amaca del pavimento pelvico: una forma per stato, si mostra quella attiva */}
  <g class="ps-amaca" stroke-linecap="round" fill="none">
    <g data-amaca="normale">
      <path d={amaca(312)} stroke="var(--c-plum-500)" stroke-width="14"></path>
      <path d={amaca(312)} stroke="#fff" stroke-opacity="0.4" stroke-width="2" stroke-dasharray="2 9"></path>
    </g>
    <g data-amaca="incontinenza">
      <path d={amaca(334)} stroke="var(--c-plum-500)" stroke-width="13"></path>
      <path d={amaca(334)} stroke="#fff" stroke-opacity="0.4" stroke-width="2" stroke-dasharray="2 9"></path>
    </g>
    <g data-amaca="prolasso">
      <path d={amaca(352)} stroke="var(--c-plum-500)" stroke-width="11"></path>
      <path d={amaca(352)} stroke="#fff" stroke-opacity="0.4" stroke-width="2" stroke-dasharray="2 11"></path>
    </g>
    <g data-amaca="riabilitazione">
      <path d={amaca(300)} stroke="var(--c-plum-700)" stroke-width="16"></path>
      <path d={amaca(300)} stroke="#fff" stroke-opacity="0.5" stroke-width="2" stroke-dasharray="2 7"></path>
    </g>
  </g>

  {/* Indicatori dei vari stati */}
  <g data-segno="pressione">
    <line x1="150" y1="78" x2="150" y2="142" stroke="var(--c-plum-700)" stroke-width="5" marker-end="url(#ps-punta)"></line>
    <text x="150" y="64" text-anchor="middle" class="ps-testo">Pressione dell’addome</text>
  </g>
  <ellipse data-segno="goccia" cx="138" cy="316" rx="5" ry="7" fill="#e9cf8f"></ellipse>
  <g data-segno="discesa">
    <line x1="206" y1="112" x2="206" y2="160" stroke="var(--c-plum-500)" stroke-width="5" marker-end="url(#ps-punta)"></line>
  </g>
  <g data-segno="sostegno" stroke="var(--c-sage-500)" stroke-width="5">
    <line x1="152" y1="334" x2="152" y2="306" marker-end="url(#ps-punta)"></line>
    <line x1="196" y1="336" x2="196" y2="312" marker-end="url(#ps-punta)"></line>
    <line x1="240" y1="334" x2="240" y2="306" marker-end="url(#ps-punta)"></line>
  </g>

  {/* Etichette */}
  <g class="ps-etichette">
    <text x="132" y="152" text-anchor="middle" data-parte="vescica">Vescica</text>
    <text x="236" y="98" text-anchor="middle" data-parte="utero">Utero</text>
    <text x="300" y="44" text-anchor="middle">Retto</text>
    <text x="330" y="318" text-anchor="middle">Pavimento pelvico</text>
    <text x="60" y="290" text-anchor="middle">Pube</text>
  </g>
</svg>

<style>
  .pelvi-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .pelvi-svg [data-parte],
  .pelvi-svg [data-amaca],
  .pelvi-svg [data-segno] {
    transition:
      transform var(--dur-modello, 900ms) var(--ease),
      opacity var(--dur-modello, 900ms) var(--ease);
  }
  @media (prefers-reduced-motion: reduce) {
    .pelvi-svg {
      --dur-modello: 0ms;
    }
  }
  .ps-etichette text,
  .ps-testo {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 650;
    fill: var(--c-ink);
    paint-order: stroke;
    stroke: var(--c-ivory);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .ps-testo {
    fill: var(--c-plum-800);
  }

  /* Stato di default: tutto nascosto tranne l'amaca normale */
  .pelvi-svg [data-amaca],
  .pelvi-svg [data-segno] {
    opacity: 0;
  }
  :global([data-stato='normale']) .pelvi-svg [data-amaca='normale'],
  :global([data-stato='incontinenza']) .pelvi-svg [data-amaca='incontinenza'],
  :global([data-stato='prolasso']) .pelvi-svg [data-amaca='prolasso'],
  :global([data-stato='riabilitazione']) .pelvi-svg [data-amaca='riabilitazione'] {
    opacity: 1;
  }

  /* Incontinenza: pressione dall'alto, vescica un po' più giù, piccola goccia */
  :global([data-stato='incontinenza']) .pelvi-svg [data-segno='pressione'],
  :global([data-stato='incontinenza']) .pelvi-svg [data-segno='goccia'] {
    opacity: 1;
  }
  :global([data-stato='incontinenza']) .pelvi-svg [data-parte='vescica'] {
    transform: translateY(12px);
  }
  :global([data-stato='incontinenza']) .pelvi-svg [data-parte='utero'] {
    transform: translateY(6px);
  }

  /* Prolasso: l'utero scende oltre l'amaca */
  :global([data-stato='prolasso']) .pelvi-svg [data-segno='discesa'] {
    opacity: 1;
  }
  :global([data-stato='prolasso']) .pelvi-svg [data-parte='utero'] {
    transform: translateY(74px);
  }
  :global([data-stato='prolasso']) .pelvi-svg [data-parte='vescica'] {
    transform: translateY(16px);
  }
  :global([data-stato='prolasso']) .pelvi-svg [data-parte='retto'] {
    transform: translateY(6px);
  }

  /* Riabilitazione: amaca più alta e tonica, frecce di sostegno */
  :global([data-stato='riabilitazione']) .pelvi-svg [data-segno='sostegno'] {
    opacity: 1;
  }
  :global([data-stato='riabilitazione']) .pelvi-svg [data-parte='vescica'],
  :global([data-stato='riabilitazione']) .pelvi-svg [data-parte='utero'] {
    transform: translateY(-4px);
  }
</style>
