---
/**
 * Foto con segnaposto automatico.
 * Basta copiare il file in src/assets/foto/ con il nome previsto (es. "ritratto.jpg"):
 * viene trovato da solo, ottimizzato (AVIF/WebP, dimensioni corrette) e mostrato.
 * Finché il file non c'è, compare un segnaposto chiaramente riconoscibile.
 *
 * Nomi previsti (vedi README → "Dove vanno le foto"):
 *   ritratto  — ritratto del medico (verticale, almeno 1200 px di lato lungo)
 *   studio-1 — sala d’attesa (studio-2: ambulatorio, da aggiungere quando c’è la foto)
 *   ecografo  — l'ecografo Samsung HM70A Plus
 *   nutrizionista — Dott.ssa Manuela Frau
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  nome: string;
  alt: string;
  /** Testo del segnaposto */
  descrizione: string;
  /** Rapporto d'aspetto (classi CSS, niente style inline per la Content Security Policy) */
  ratio?: '4 / 5' | '4 / 3' | '3 / 2' | '1 / 1' | '16 / 9';
  /** Larghezze per srcset */
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  nome,
  alt,
  descrizione,
  ratio = '4 / 5',
  widths = [480, 720, 960, 1200],
  sizes = '(min-width: 64rem) 40vw, 100vw',
  loading = 'lazy',
  class: className,
} = Astro.props;

const foto = import.meta.glob<{ default: ImageMetadata }>('/src/assets/foto/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const classeRatio = `foto--r${ratio.replace(/[^0-9]/g, '')}`;
const trovata = Object.entries(foto).find(([percorso]) =>
  new RegExp(`/${nome}\\.(jpe?g|png|webp|avif)$`, 'i').test(percorso),
)?.[1].default;
// Solo larghezze non superiori all'originale (niente ingrandimenti); foto piccole: la loro misura reale.
const larghezze = trovata
  ? widths.filter((w) => w <= trovata.width).length
    ? widths.filter((w) => w <= trovata.width)
    : [trovata.width]
  : [];
---

{
  trovata ? (
    <Picture
      src={trovata}
      alt={alt}
      formats={['avif', 'webp']}
      widths={larghezze}
      sizes={sizes}
      loading={loading}
      class:list={['foto', classeRatio, className]}
    />
  ) : (
    <div class:list={['foto', 'foto--segnaposto', classeRatio, className]} role="img" aria-label={alt}>
      <svg viewBox="0 0 200 200" aria-hidden="true" class="foto__forma">
        <circle cx="70" cy="80" r="70" fill="var(--c-plum-100)" />
        <circle cx="140" cy="130" r="60" fill="var(--c-sage-100)" />
      </svg>
      <span class="segnaposto">[DA INSERIRE: foto — {descrizione}]</span>
    </div>
  )
}

<style>
  .foto {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--color-bg-alt);
  }
  .foto--r45 {
    aspect-ratio: 4 / 5;
  }
  .foto--r43 {
    aspect-ratio: 4 / 3;
  }
  .foto--r32 {
    aspect-ratio: 3 / 2;
  }
  .foto--r11 {
    aspect-ratio: 1 / 1;
  }
  .foto--r169 {
    aspect-ratio: 16 / 9;
  }
  .foto--segnaposto {
    position: relative;
    display: grid;
    place-items: end start;
    padding: var(--space-5);
    overflow: hidden;
    border: 1px dashed var(--c-plum-300);
    background: linear-gradient(160deg, var(--c-plum-50), var(--c-sand-50));
  }
  .foto__forma {
    position: absolute;
    inset: 10% 10% auto auto;
    width: 70%;
    opacity: 0.9;
  }
  .foto--segnaposto .segnaposto {
    position: relative;
    font-size: var(--fs-small);
  }
</style>
