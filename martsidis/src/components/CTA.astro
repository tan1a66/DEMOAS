---
import ContactButtons from './ContactButtons.astro';
import { useTranslations } from '@/i18n';

interface Props {
  title?: string;
  text?: string;
  id?: string;
}

const t = useTranslations();
const { title = t('cta.title'), text = t('cta.text'), id = 'contatta' } = Astro.props;
---

<aside class="cta" aria-labelledby={`${id}-titolo`}>
  <div class="cta__inner">
    <div class="cta__text">
      <h2 id={`${id}-titolo`}>{title}</h2>
      <p>{text}</p>
      <slot />
    </div>
    <ContactButtons secondary="light" />
  </div>
</aside>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    margin-block: var(--space-8);
    padding: clamp(1.75rem, 1rem + 3vw, 3.25rem);
    border-radius: var(--radius-lg);
    background: var(--c-plum-800);
    color: var(--color-on-dark);
  }
  .cta__inner {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }
  @media (min-width: 56rem) {
    .cta__inner {
      grid-template-columns: 1.4fr auto;
      gap: var(--space-7);
    }
  }
  .cta h2 {
    color: var(--c-white);
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.2rem);
  }
  .cta p {
    color: var(--color-on-dark);
    max-width: 38em;
  }
  .cta__text :global(p:last-child) {
    margin-bottom: 0;
  }
  .cta :global(.btn--secondary) {
    background: transparent;
    color: var(--c-white);
    border-color: rgb(255 255 255 / 0.6);
  }
  .cta :global(.btn--light + .btn--light) {
    background: transparent;
    color: var(--c-white);
    border-color: rgb(255 255 255 / 0.65);
  }
  .cta :global(.btn--light + .btn--light:hover) {
    background: rgb(255 255 255 / 0.12);
  }
</style>
