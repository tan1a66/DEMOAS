---
/** Intestazione delle pagine interne: occhiello, H1, sottotitolo e (facoltativi) pulsanti di contatto. */
import ContactButtons from './ContactButtons.astro';

interface Props {
  titolo: string;
  eyebrow?: string;
  lead?: string;
  contatti?: boolean;
}
const { titolo, eyebrow, lead, contatti = true } = Astro.props;
---

<header class="page-hero">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{titolo}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
    {
      contatti && (
        <div class="page-hero__cta">
          <ContactButtons size="md" />
        </div>
      )
    }
  </div>
</header>

<style>
  .page-hero {
    padding-block: var(--space-6) var(--space-7);
    background:
      radial-gradient(50% 80% at 100% 0%, rgb(236 227 242 / 0.85), transparent 70%),
      radial-gradient(40% 60% at 0% 100%, rgb(229 237 230 / 0.6), transparent 70%);
  }
  .page-hero h1 {
    max-width: 22em;
  }
  .page-hero .lead {
    margin-bottom: 0;
  }
  .page-hero__cta {
    margin-top: var(--space-6);
  }
</style>
