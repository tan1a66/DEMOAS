---
/**
 * Esperienza 3D della Home, guidata dallo scroll.
 * - La massa iniziale nasce crescendo e, scorrendo, si trasforma nel modello (nessuna dissolvenza).
 * - Desktop: il disegno sta nella colonna destra di ogni sezione ([data-esp-area]); i testi a sinistra.
 * - Telefono: finché è massa (e mentre si trasforma) sta DIETRO ai testi; quando il modello è completo
 *   prende un suo spazio in alto (.esp__sipario, "palco") e da lì i testi non gli passano più sopra.
 * - L'anello delle problematiche è un'ellisse in prospettiva attorno al modello: davanti le voci passano
 *   sotto, dietro rimpiccioliscono e spariscono. Si gira con lo scroll, con un clic o, su telefono, col dito.
 * - Il disegno statico (.esp__statico) compare SOLO se il 3D non può partire (movimento ridotto, niente WebGL, ?no3d).
 */
import Button from './Button.astro';
import HeroBlob from './HeroBlob.astro';
import { PROBLEMATICHE } from '@/three/pelvi/stati';
import { sito } from '@/data/sito';
import { useTranslations } from '@/i18n';

const t = useTranslations();
const legenda = [
  { id: 'vescica', nome: 'Vescica' },
  { id: 'utero', nome: 'Utero, tube e ovaie' },
  { id: 'retto', nome: 'Retto' },
  { id: 'pavimento', nome: 'Pavimento pelvico' },
  { id: 'bacino', nome: 'Bacino' },
];
---

<div class="esp" data-esperienza>
  <div class="esp__canvas" data-esp-canvas aria-hidden="true"></div>
  {/* Telefono: spazio del modello completo. Compare (senza occupare posto nella pagina) solo quando serve. */}
  <div class="esp__sipario" data-esp-sipario aria-hidden="true"></div>

  <section class="esp-hero" data-esp="hero" aria-labelledby="hero-titolo">
    {/* Telefono: dove sta la massa all'inizio, dietro al titolo */}
    <div class="esp-hero__zona" data-esp-zona aria-hidden="true">
      <div class="esp__statico"><HeroBlob uid="m" /></div>
    </div>
    <div class="container esp-due">
      <div class="esp-col-testo">
        <p class="esp-hero__luogo">Uroginecologia a Cagliari</p>
        <h1 id="hero-titolo">Incontinenza, prolasso, pavimento pelvico: problemi comuni, che si possono curare.</h1>
        <p class="esp-hero__sotto">
          <strong>{sito.nome}</strong>, uroginecologo. {sito.ruoloOspedaliero}.
        </p>
        <div class="esp-solo-desktop">
          <Button href="/prenota-una-visita/" size="lg" data-prenota>{t('cta.book')}</Button>
        </div>
      </div>
      <div class="esp-area" data-esp-area aria-hidden="true">
        <div class="esp__statico"><HeroBlob uid="d" /></div>
      </div>
    </div>
  </section>

  <section class="esp-compone" data-esp="compone" id="normale" aria-labelledby="compone-titolo">
    <div class="esp-fisso">
      <div class="container esp-due">
        <div class="esp-col-testo">
          <h2 id="compone-titolo">Un’amaca di muscoli sostiene vescica, utero e intestino.</h2>
          <p class="esp-testo" data-esp-fine-testo>
            È il pavimento pelvico. Quando cede, o è troppo teso, compaiono disturbi molto diffusi, di cui spesso non
            si parla.
          </p>
          <div class="esp-legenda-blocco">
            <ul class="esp-legenda" role="list">
              {
                legenda.map((l) => (
                  <li>
                    <i class={`esp-pall esp-pall--${l.id}`} />
                    {l.nome}
                  </li>
                ))
              }
            </ul>
            <p class="esp-nota">{t('note.modello')}</p>
          </div>
          <div class="esp-compone__spazio" aria-hidden="true"></div>
        </div>
        <div class="esp-area" data-esp-area aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="esp-orbita" data-esp="orbita" id="problematiche" aria-labelledby="orbita-titolo">
    <div class="esp-orbita__fisso">
      <div class="esp-orbita__testo">
        <div class="esp-orbita__titolo">
          <h2 id="orbita-titolo">Si riconosce in una di queste situazioni?</h2>
          <p class="esp-orbita__aiuto">
            <span class="esp-solo-desktop">Scorra o scelga una voce: il cerchio gira attorno al modello.</span>
            <span class="esp-solo-telefono">Scorra, oppure faccia girare il cerchio col dito.</span>
          </p>
        </div>
        <div class="esp-orbita__pannello" id="esp-pannello" aria-live="polite" data-esp-pannello></div>
      </div>
      <div class="esp-orbita__scena" data-esp-scena aria-hidden="true"></div>
    </div>
    <svg class="esp-orbita__anello" data-esp-anello aria-hidden="true" focusable="false"><path></path></svg>
    <ol class="esp-voci">
      {
        PROBLEMATICHE.map((p, i) => (
          <li id={p.id} class="esp-voce" data-esp-voce={i}>
            <button type="button" class="esp-voce__btn" data-esp-vai={i} aria-describedby="esp-pannello">
              <span class="esp-voce__frase">«{p.frase}»</span>
              <span class="esp-voce__nome">{p.nome}</span>
            </button>
            <div class="esp-voce__dettaglio">
              <p>{p.testo}</p>
              <a href={p.link}>Approfondisca: {p.nome}</a>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="esp-percorso" data-esp="percorso" id="riabilitazione" aria-labelledby="percorso-titolo">
    <div class="esp-fisso">
      <div class="container esp-due">
        <div class="esp-col-testo">
          <h2 id="percorso-titolo">Il percorso di cura parte sempre dal più semplice.</h2>
          <ol class="esp-passi">
            <li><strong>Prenota.</strong> Non serve spiegare il motivo, se non vuole.</li>
            <li><strong>La visita, con calma.</strong> Prima si parla, poi la visita: ogni passaggio viene spiegato.</li>
            <li>
              <strong>Le possibilità di cura.</strong> Abitudini, riabilitazione, terapie e, solo se serve, un intervento.
              Decide insieme al Dottore.
            </li>
          </ol>
          <div class="esp-solo-desktop">
            <Button href="/prenota-una-visita/" size="lg" data-prenota>{t('cta.book')}</Button>
          </div>
        </div>
        <div class="esp-area" data-esp-area aria-hidden="true"></div>
      </div>
    </div>
  </section>
</div>

<script>
  import { riduciMovimento, disattivatoDaUrl, webglDisponibile } from '../three/shared/capacita';
  import { PROBLEMATICHE, type IdStato } from '../three/pelvi/stati';

  type Scena = Awaited<ReturnType<typeof import('../three/esperienza/scena').monta>>;
  type Area = { x: number; y: number; w: number; h: number };

  const clamp = (v: number, a = 0, b = 1) => Math.min(Math.max(v, a), b);
  const ease = (t: number) => t * t * (3 - 2 * t);
  const mix = (a: number, b: number, t: number) => a + (b - a) * t;
  /** Scala di una voce: grande davanti (prof = 1), piccola di lato, sparisce dietro al modello (prof → -1). */
  const scalaVoce = (prof: number) => (0.45 + 0.55 * ((prof + 1) / 2)) * ease(clamp((prof + 0.95) / 0.6));
  // Sagoma del modello rispetto al raggio della sua sfera (il bacino è largo ma basso): serve a dargli più spazio.
  const SAGOMA = { x: 0.97, xGiu: 0.75, giu: 0.7, su: 0.85 }; // xGiu: sotto il centro il bacino si stringe

  function avvia(radice: HTMLElement) {
    const q = (s: string) => radice.querySelector<HTMLElement>(s)!;
    const host = q('[data-esp-canvas]');
    const hero = q('[data-esp="hero"]');
    const compone = q('[data-esp="compone"]');
    const orbita = q('[data-esp="orbita"]');
    const percorso = q('[data-esp="percorso"]');
    const sipario = q('[data-esp-sipario]');
    const zona = q('[data-esp-zona]');
    const fineTesto = q('[data-esp-fine-testo]');
    const scenaEl = q('[data-esp-scena]');
    const tracciato = radice.querySelector<SVGPathElement>('[data-esp-anello] path')!;
    const pannello = q('[data-esp-pannello]');
    const voci = [...radice.querySelectorAll<HTMLElement>('[data-esp-voce]')];
    const header = document.querySelector<HTMLElement>('[data-header]');
    const N = voci.length;
    const mq = window.matchMedia('(max-width: 63.99rem)');
    let scena: Scena | null = null;
    let attiva = -1;
    let fineTrascinamento = 0;

    // Se lo script viene rieseguito (anteprima in un file: si torna alla Home), chiude l'istanza precedente.
    const w = window as Window & { __espFine?: () => void };
    w.__espFine?.();
    const ctl = new AbortController();
    const signal = ctl.signal;
    w.__espFine = () => {
      ctl.abort();
      scena?.dispose();
    };

    radice.classList.add('is-3d');

    // — Anello: un'ellisse in prospettiva (più ampia davanti, schiacciata dietro) attorno al modello —
    const geo = { cx: 0, cy: 0, rx: 0, ryF: 0, ryB: 0, R: 80 };
    let larghezze: number[] = [];
    const punto = (a: number, k = 1): [number, number] => [
      geo.cx + Math.sin(a) * geo.rx * k,
      geo.cy + Math.cos(a) * (Math.cos(a) >= 0 ? geo.ryF : geo.ryB) * k,
    ];
    const misura = () => {
      const vh = window.innerHeight;
      const hH = header?.offsetHeight ?? 72;
      const mobile = mq.matches;
      const rs = scenaEl.getBoundingClientRect();
      const reg = mobile
        ? { x: 0, y: hH, w: window.innerWidth, h: sipario.offsetHeight }
        : { x: rs.left, y: hH, w: rs.width, h: vh - hH };
      larghezze = voci.map((v) => v.offsetWidth);
      const vw = Math.max(...larghezze);
      const vhh = Math.max(...voci.map((v) => v.offsetHeight));
      const vicina = (Math.PI * 2) / N; // angolo della voce accanto a quella attiva
      const rx = mobile
        ? (reg.w / 2 - 6 - (vw / 2) * scalaVoce(Math.cos(vicina))) / Math.sin(vicina) // le due vicine si leggono intere
        : Math.min(reg.w / 2 - vw / 2 - 8, 540);
      // Il modello più grande possibile: le voci della metà davanti devono restare fuori dalla sua sagoma.
      const alto = SAGOMA.su + SAGOMA.giu;
      let R = Math.min((reg.h - vhh - 28) / alto, (reg.w / 2 - 8) / SAGOMA.x);
      // telefono: le voci di lato restano dentro lo schermo, quindi il modello deve lasciar loro posto
      if (mobile) R = Math.min(R, (reg.w / 2 - 10 - vw * scalaVoce(Math.cos(2 * vicina))) / SAGOMA.x);
      let stacco = 12;
      for (; R > 40; R -= 2) {
        stacco = Math.min(reg.h - 16 - vhh - alto * R, 0.6 * R, 0.85 * rx - SAGOMA.giu * R - vhh / 2);
        if (stacco < 12) continue;
        const ryF = SAGOMA.giu * R + vhh / 2 + stacco;
        let libero = true;
        for (let g = -90; g <= 90 && libero; g += 3) {
          const a = (g * Math.PI) / 180;
          const s = scalaVoce(Math.cos(a));
          const ax = Math.min(Math.abs(Math.sin(a)) * rx, window.innerWidth / 2 - ((vw / 2) * s + 6));
          const dx = Math.max(ax - (vw / 2) * s, 0);
          const dy = Math.max(Math.cos(a) * ryF - (vhh / 2) * s, 0);
          libero = (dx / (SAGOMA.xGiu * R + 8)) ** 2 + (dy / (SAGOMA.giu * R + 8)) ** 2 >= 1;
        }
        if (libero) break;
      }
      stacco = Math.max(stacco, 12);
      geo.R = R;
      geo.rx = rx;
      geo.ryF = SAGOMA.giu * R + vhh / 2 + stacco;
      geo.ryB = geo.ryF * 0.42;
      geo.cx = reg.x + reg.w / 2;
      geo.cy = reg.y + (reg.h - (alto * R + stacco + vhh + 16)) / 2 + 8 + SAGOMA.su * R;
    };

    // — Stato dell'esperienza in base allo scroll —
    const leggi = () => {
      const vh = window.innerHeight;
      const hH = header?.offsetHeight ?? 72;
      const mobile = mq.matches;
      const palcoH = sipario.offsetHeight;
      const stick = mobile ? hH + palcoH : hH; // linea sotto cui scorrono i testi quando il modello ha il suo spazio
      const rComp = compone.getBoundingClientRect();
      const rOrb = orbita.getBoundingClientRect();
      const rPerc = percorso.getBoundingClientRect();
      const rEsp = radice.getBoundingClientRect();
      const mid = (stick + vh) / 2;
      const quale = rPerc.top <= mid ? 'percorso' : rOrb.top <= mid ? 'orbita' : rComp.top <= mid ? 'compone' : 'hero';

      // La trasformazione occupa quasi tutta la sezione "compone".
      // Telefono: finisce quando l'ultimo testo è uscito in alto, così il modello completo resta libero.
      let montaggio: number;
      let avanza = 1; // telefono: 0 → 1 mentre i testi passano sopra la massa
      if (mobile) {
        const parte = vh * 0.8;
        const fondo = fineTesto.getBoundingClientRect().bottom; // fondo dell'ultimo testo che passa sopra
        avanza = clamp((parte - rComp.top) / Math.max(fondo - rComp.top + parte - hH, 1));
        // finché i testi le passano sopra la trasformazione arriva al 70%; si completa solo dopo, a spazio libero
        montaggio = avanza < 1 ? avanza * 0.7 : 0.7 + 0.3 * clamp((hH - fondo) / (vh * 0.35));
      } else {
        montaggio = clamp((vh * 0.3 - rComp.top) / Math.max(rComp.height - vh * 0.9, vh * 0.6));
      }
      const palco = mobile && avanza >= 0.999;

      const corsa = Math.max(rOrb.height - (vh - stick), 1);
      const indice = clamp((stick - rOrb.top) / corsa) * (N - 1);
      const nuova = Math.round(indice);
      // l'anello "cresce" entrando nella sezione e si richiude uscendo (legato allo scroll)
      const apertura = Math.min(
        clamp((mid - rOrb.top) / Math.max(mid - stick, 1)),
        clamp((rOrb.bottom - vh * 0.45) / (vh * 0.55)),
      );

      let area: Area;
      // alla fine dell'esperienza il palco esce scorrendo insieme alla pagina
      const esce = mobile ? Math.min(rEsp.bottom - (hH + palcoH), 0) : 0;
      const palcoArea = { x: 8, y: hH + 8 + esce, w: window.innerWidth - 16, h: palcoH - 16 };
      if (quale === 'orbita') {
        area = { x: geo.cx - geo.R, y: geo.cy - geo.R, w: geo.R * 2, h: geo.R * 2 };
      } else if (mobile) {
        if (quale === 'percorso') area = palcoArea;
        else {
          // dalla posizione dietro al titolo allo spazio in alto, insieme alla trasformazione
          const r = zona.getBoundingClientRect();
          const t = ease(avanza);
          const yZona = Math.max(r.top, hH - r.height * 0.35);
          area = {
            x: mix(r.left, palcoArea.x, t),
            y: mix(yZona, palcoArea.y, t),
            w: mix(r.width, palcoArea.w, t),
            h: mix(r.height, palcoArea.h, t),
          };
        }
      } else {
        const sezione = quale === 'hero' ? hero : quale === 'compone' ? compone : percorso;
        const r = sezione.querySelector<HTMLElement>('[data-esp-area]')!.getBoundingClientRect();
        const yc = hH + (vh - hH - r.height) / 2; // centrato nella fascia sotto l'intestazione
        const y = quale === 'hero' ? Math.max(r.top, yc) : quale === 'compone' ? yc : Math.min(r.top, yc);
        area = { x: r.left, y, w: r.width, h: r.height };
      }
      const stato: IdStato =
        quale === 'orbita' ? PROBLEMATICHE[nuova]!.id : quale === 'percorso' ? 'riabilitazione' : 'normale';
      return { quale, montaggio, indice, nuova, apertura, area, stato, stick, corsa, mobile, palco, esce };
    };
    let ora = leggi();

    const comando = (s: ReturnType<typeof leggi>) => ({
      montaggio: s.montaggio,
      stato: s.stato,
      giro: s.quale === 'orbita' ? -s.indice * 0.35 : 0,
      area: s.area,
    });

    // Le voci sull'anello. I valori seguono lo scroll con un po' di inerzia: il cerchio scivola, non scatta.
    const morbido = { indice: 0, apertura: 0 };
    const disponi = () => {
      const e = ease(morbido.apertura);
      const k = 1 + (1 - e) * 0.3;
      voci.forEach((v, i) => {
        const a = ((i - morbido.indice) / N) * Math.PI * 2;
        const prof = Math.cos(a);
        const sc = scalaVoce(prof) * e;
        const [px, y] = punto(a, k);
        const meta = ((larghezze[i] ?? 0) * sc) / 2 + 6;
        const x = clamp(px, meta, window.innerWidth - meta); // resta sempre dentro lo schermo
        v.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) translate(-50%, -50%) scale(${sc.toFixed(3)})`;
        v.style.zIndex = String(Math.round(prof * 10) + 20);
      });
      let d = '';
      for (let g = 0; g <= 360; g += 5) {
        const [x, y] = punto((g * Math.PI) / 180, k);
        d += `${g ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
      }
      tracciato.setAttribute('d', d + 'Z');
      tracciato.style.strokeWidth = e.toFixed(2);
    };
    let ultimoT = 0;
    let girando = false;
    const gira = (adesso: number) => {
      const dt = Math.min((adesso - ultimoT) / 1000, 0.05);
      ultimoT = adesso;
      const k = 1 - Math.exp(-dt * 9);
      morbido.indice += (ora.indice - morbido.indice) * k;
      morbido.apertura += (ora.apertura - morbido.apertura) * k;
      disponi();
      if (Math.abs(ora.indice - morbido.indice) > 0.002 || Math.abs(ora.apertura - morbido.apertura) > 0.002) {
        requestAnimationFrame(gira);
      } else {
        girando = false;
      }
    };
    const avviaGiro = () => {
      if (girando || signal.aborted) return;
      girando = true;
      ultimoT = performance.now();
      requestAnimationFrame(gira);
    };

    const mostra = (i: number) => {
      attiva = i;
      voci.forEach((v, k) => v.classList.toggle('is-attiva', k === i));
      const p = PROBLEMATICHE[i]!;
      const dettaglio = voci[i]!.querySelector('.esp-voce__dettaglio')!;
      pannello.innerHTML = `<p class="esp-pannello__frase">«${p.frase}»</p><p class="esp-pannello__nome">${p.nome}</p>${dettaglio.innerHTML}`;
    };

    const aggiorna = () => {
      ora = leggi();
      scena?.comanda(comando(ora));
      // telefono: finché si trasforma il disegno sta dietro ai testi; da completo passa davanti e ha il suo spazio
      radice.classList.toggle('is-dietro', ora.mobile && !ora.palco);
      radice.classList.toggle('is-palco', ora.palco);
      sipario.style.transform = ora.esce ? `translateY(${ora.esce.toFixed(1)}px)` : '';
      // quando l'area è uscita dallo schermo il disegno non serve più (esce scorrendo, senza dissolvenze)
      host.style.visibility = ora.area.y + ora.area.h < 0 ? 'hidden' : '';
      host.dataset.area = [ora.area.x, ora.area.y, ora.area.w, ora.area.h].map(Math.round).join(','); // utile per i test
      radice.classList.toggle('is-orbita', ora.apertura > 0.6);
      if (ora.nuova !== attiva && (ora.quale === 'orbita' || attiva < 0)) mostra(ora.nuova);
      avviaGiro();
    };

    // clic (o focus da tastiera) su una voce: lo scroll porta il cerchio su quella problematica
    const vai = (i: number, liscio = true) => {
      const s = leggi();
      const rOrb = orbita.getBoundingClientRect();
      window.scrollTo({
        top: window.scrollY + rOrb.top - s.stick + (i / (N - 1)) * s.corsa + 1,
        behavior: liscio ? 'smooth' : 'auto',
      });
    };
    radice.querySelectorAll<HTMLButtonElement>('[data-esp-vai]').forEach((b) => {
      const i = Number(b.dataset.espVai);
      b.addEventListener('click', () => {
        if (performance.now() - fineTrascinamento > 350) vai(i);
      });
      b.addEventListener('focus', () => {
        if (!radice.classList.contains('is-orbita')) vai(i, false);
      });
    });

    // Trascinare sul disegno: su desktop ruota il modello; su telefono, nel cerchio, lo fa girare col dito
    // (solo in orizzontale: lo scroll verticale resta libero).
    let drag: { x: number; y: number; id: number; fatto: number } | null = null;
    radice.addEventListener('pointerdown', (e) => {
      const bersaglio = e.target as HTMLElement;
      if (!bersaglio.closest('[data-esp-area], [data-esp-sipario], [data-esp-scena], .esp-voce')) return;
      drag = { x: e.clientX, y: e.clientY, id: e.pointerId, fatto: 0 };
    });
    window.addEventListener(
      'pointermove',
      (e) => {
        if (!drag || e.pointerId !== drag.id) return;
        const dx = e.clientX - drag.x;
        const dy = e.clientY - drag.y;
        drag.x = e.clientX;
        drag.y = e.clientY;
        drag.fatto += Math.abs(dx);
        if (ora.mobile && ora.quale === 'orbita') {
          window.scrollBy(0, (-dx * ora.corsa) / (N - 1) / 130); // 130 px di dito = una voce
        } else {
          scena?.trascina(dx, e.pointerType === 'touch' ? 0 : dy);
        }
      },
      { signal },
    );
    const fineDrag = () => {
      if (drag && drag.fatto > 8) fineTrascinamento = performance.now();
      drag = null;
    };
    window.addEventListener('pointerup', fineDrag, { signal });
    window.addEventListener('pointercancel', fineDrag, { signal });

    let inCoda = false;
    const pianifica = () => {
      if (inCoda) return;
      inCoda = true;
      requestAnimationFrame(() => {
        inCoda = false;
        aggiorna();
      });
    };
    window.addEventListener('scroll', pianifica, { passive: true, signal });
    window.addEventListener(
      'resize',
      () => {
        misura();
        pianifica();
      },
      { signal },
    );
    misura();
    aggiorna();
    document.fonts?.ready.then(() => {
      misura();
      aggiorna();
    });

    // deep link: /#prolasso, /#urgenza… porta il cerchio su quella problematica
    const daHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const i = PROBLEMATICHE.findIndex((p) => p.id === id);
      if (i >= 0) requestAnimationFrame(() => vai(i, false));
    };
    daHash();
    window.addEventListener('hashchange', daHash, { signal });

    // Il 3D parte subito: non c'è una versione statica "prima". La massa nasce crescendo.
    (async () => {
      try {
        const { monta } = await import('../three/esperienza/scena');
        scena = await monta(host, comando(leggi()));
        if (signal.aborted) return scena.dispose();
        radice.classList.add('is-pronto');
        aggiorna();
      } catch (errore) {
        console.warn('3D non disponibile: resta la versione statica.', errore);
        radice.classList.remove('is-3d', 'is-dietro', 'is-palco');
        radice.classList.add('is-statico');
      }
    })();
  }

  const radice = document.querySelector<HTMLElement>('[data-esperienza]');
  if (radice) {
    if (disattivatoDaUrl() || riduciMovimento() || !webglDisponibile()) radice.classList.add('is-statico');
    else avvia(radice);
  }
</script>

