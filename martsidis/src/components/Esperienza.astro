---
/**
 * Esperienza 3D della Home, guidata dallo scroll:
 * 1. hero: la "palla"; 2. la palla diventa l'utero e gli organi si compongono attorno;
 * 3. l'anello delle problematiche gira attorno al modello (scroll o clic) e il modello mostra lo stato;
 * 4. il percorso di cura (riabilitazione).
 * Senza WebGL, con "riduci movimento" o con ?no3d: versione statica (elenco leggibile, nessuna animazione).
 */
import ContactButtons from './ContactButtons.astro';
import HeroBlob from './HeroBlob.astro';
import Icon from './Icon.astro';
import { PROBLEMATICHE } from '@/three/pelvi/stati';
import { sito } from '@/data/sito';
---

<div class="esp" data-esperienza>
  <div class="esp__canvas" data-esp-canvas aria-hidden="true"></div>

  <section class="esp-hero" data-esp="hero" aria-labelledby="hero-titolo">
    <div class="container esp-hero__inner">
      <p class="eyebrow">Uroginecologia a Cagliari</p>
      <h1 id="hero-titolo">Incontinenza, prolasso, pavimento pelvico: problemi comuni, che si possono curare.</h1>
      <p class="esp-hero__sotto">
        <strong>{sito.nome}</strong>, uroginecologo. {sito.ruoloOspedaliero}.
      </p>
      <ContactButtons />
      <p class="esp-hero__scroll" aria-hidden="true"><span></span> Scorra: il modello si compone</p>
    </div>
    <div class="esp-hero__statico"><HeroBlob /></div>
  </section>

  <section class="esp-compone" data-esp="compone" id="normale" aria-labelledby="compone-titolo">
    <div class="esp-compone__sticky">
      <div class="container">
        <p class="esp-num">01</p>
        <h2 id="compone-titolo">Un’amaca di muscoli sostiene vescica, utero e intestino.</h2>
        <p class="esp-testo">
          È il pavimento pelvico. Quando cede, o è troppo teso, compaiono disturbi molto diffusi. Il modello è una
          rappresentazione semplificata a scopo divulgativo.
        </p>
      </div>
    </div>
  </section>

  <section class="esp-orbita" data-esp="orbita" id="problematiche" aria-labelledby="orbita-titolo">
    <div class="esp-orbita__sticky" data-esp-superficie>
      <div class="container esp-orbita__testa">
        <p class="esp-num">02</p>
        <h2 id="orbita-titolo">Si riconosce in una di queste situazioni?</h2>
        <p class="esp-orbita__aiuto"><Icon name="arrow-right" size={18} /> Scorra o scelga: il cerchio gira e il modello mostra cosa succede.</p>
      </div>
      <div class="esp-orbita__anello" data-esp-anello aria-hidden="true"></div>
      <ol class="esp-orbita__voci">
        {
          PROBLEMATICHE.map((p, i) => (
            <li id={p.id} class="esp-voce" data-esp-voce={i}>
              <button type="button" class="esp-voce__btn" data-esp-vai={i} aria-describedby="esp-pannello">
                <span class="esp-voce__frase">«{p.frase}»</span>
                <span class="esp-voce__nome">{p.nome}</span>
              </button>
              <div class="esp-voce__dettaglio">
                <p>{p.testo}</p>
                <a href={p.link}>Approfondisca: {p.nome}</a>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="esp-orbita__pannello" id="esp-pannello" aria-live="polite" data-esp-pannello></div>
    </div>
  </section>

  <section class="esp-percorso" data-esp="percorso" id="riabilitazione" aria-labelledby="percorso-titolo">
    <div class="container esp-percorso__inner">
      <p class="esp-num">03</p>
      <h2 id="percorso-titolo">Il percorso di cura: si parte sempre dal più semplice.</h2>
      <ol class="esp-passi">
        <li><strong>Un messaggio o una telefonata.</strong> Non serve spiegare il motivo, se non vuole.</li>
        <li><strong>La visita, con calma.</strong> Prima si parla, poi la visita, ogni passaggio spiegato.</li>
        <li><strong>Le possibilità di cura.</strong> Abitudini, riabilitazione, terapie e, solo se serve, un intervento. Decide insieme al Dottore.</li>
      </ol>
      <ContactButtons />
    </div>
  </section>
</div>

<script>
  import { riduciMovimento, disattivatoDaUrl, webglDisponibile, quandoLibero } from '../three/shared/capacita';
  import { PROBLEMATICHE, isIdStato, type IdStato } from '../three/pelvi/stati';

  type Scena = Awaited<ReturnType<typeof import('../three/esperienza/scena').monta>>;
  const radice = document.querySelector<HTMLElement>('[data-esperienza]');

  if (radice && !disattivatoDaUrl() && !riduciMovimento() && webglDisponibile()) {
    const host = radice.querySelector<HTMLElement>('[data-esp-canvas]')!;
    const sez = (n: string) => radice.querySelector<HTMLElement>(`[data-esp="${n}"]`)!;
    const hero = sez('hero'), compone = sez('compone'), orbita = sez('orbita'), percorso = sez('percorso');
    const voci = [...radice.querySelectorAll<HTMLElement>('[data-esp-voce]')];
    const pannello = radice.querySelector<HTMLElement>('[data-esp-pannello]')!;
    const N = voci.length;
    const mobile = () => window.matchMedia('(max-width: 63.99rem)').matches;
    let scena: Scena | null = null;
    let attiva = -1;

    radice.classList.add('is-3d'); // layout "scroll" (sezioni alte e fisse); la grafica arriva dopo
    const clamp = (v: number) => Math.min(Math.max(v, 0), 1);
    const progressoFisso = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      return clamp(-r.top / Math.max(r.height - window.innerHeight, 1));
    };

    const aggiorna = () => {
      const vh = window.innerHeight;
      const rHero = hero.getBoundingClientRect();
      const rComp = compone.getBoundingClientRect();
      const rPerc = percorso.getBoundingClientRect();
      // montaggio: comincia mentre si lascia l'hero, finisce a metà della sezione "compone"
      const montaggio = clamp((vh - rComp.top) / (rComp.height + vh * 0.2));
      const giroP = progressoFisso(orbita);
      const indice = giroP * (N - 1);
      const nuova = Math.round(indice);
      let stato: IdStato = 'normale';
      const inOrbita = orbita.getBoundingClientRect().top < vh * 0.5;
      if (inOrbita) stato = PROBLEMATICHE[nuova]!.id;
      if (rPerc.top < vh * 0.55) stato = 'riabilitazione';
      const uscita = clamp((vh * 0.35 - rPerc.bottom) / (vh * 0.4));
      const posto = mobile() ? 0 : rHero.bottom > vh * 0.5 ? 0.45 : inOrbita && rPerc.top > vh * 0.55 ? -0.2 : 0.42;
      scena?.comanda({ montaggio, stato, giro: inOrbita ? -indice * 0.35 : 0, posto, opacita: 1 - uscita });
      host.style.opacity = String(1 - uscita);
      disponiAnello(indice);
      if (inOrbita && nuova !== attiva) mostra(nuova);
    };

    // Le voci girano su un'ellisse attorno al modello: davanti grandi e nitide, dietro piccole e tenui.
    const disponiAnello = (indice: number) => {
      const w = window.innerWidth, h = window.innerHeight;
      const rx = Math.min(w * (mobile() ? 0.4 : 0.3), 520), ry = rx * (mobile() ? 0.42 : 0.3);
      const cx = w * (mobile() ? 0.5 : 0.4), cy = h * (mobile() ? 0.4 : 0.52);
      voci.forEach((v, i) => {
        const a = ((i - indice) / N) * Math.PI * 2;
        const prof = Math.cos(a); // 1 davanti, -1 dietro
        const x = cx + Math.sin(a) * rx, y = cy + prof * ry;
        const s = 0.62 + 0.38 * ((prof + 1) / 2);
        v.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) translate(-50%, -50%) scale(${s.toFixed(3)})`;
        v.style.opacity = String(0.25 + 0.75 * ((prof + 1) / 2) ** 1.5);
        v.style.zIndex = String(Math.round(prof * 10) + 20);
      });
    };

    const mostra = (i: number) => {
      attiva = i;
      voci.forEach((v, k) => v.classList.toggle('is-attiva', k === i));
      const det = voci[i]!.querySelector('.esp-voce__dettaglio')!;
      const nome = voci[i]!.querySelector('.esp-voce__nome')!.textContent;
      pannello.innerHTML = `<p class="esp-pannello__nome">${nome}</p>${det.innerHTML}`;
    };

    // clic su una voce: lo scroll porta l'anello su quella problematica
    const vai = (i: number, liscio = true) => {
      const top = orbita.getBoundingClientRect().top + window.scrollY;
      const corsa = orbita.offsetHeight - window.innerHeight;
      window.scrollTo({ top: top + (i / (N - 1)) * corsa + 2, behavior: liscio ? 'smooth' : 'auto' });
    };
    radice.querySelectorAll<HTMLButtonElement>('[data-esp-vai]').forEach((b) =>
      b.addEventListener('click', () => vai(Number(b.dataset.espVai))),
    );

    // trascinare sul modello lo fa ruotare (su touch solo in orizzontale: lo scroll verticale resta libero)
    const sup = radice.querySelector<HTMLElement>('[data-esp-superficie]')!;
    let drag: { x: number; y: number; id: number } | null = null;
    sup.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('button, a')) return;
      drag = { x: e.clientX, y: e.clientY, id: e.pointerId };
    });
    window.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      scena?.trascina(e.clientX - drag.x, e.pointerType === 'touch' ? 0 : e.clientY - drag.y);
      drag.x = e.clientX;
      drag.y = e.clientY;
    });
    window.addEventListener('pointerup', () => (drag = null));

    let inCoda = false;
    const suScroll = () => {
      if (inCoda) return;
      inCoda = true;
      requestAnimationFrame(() => {
        inCoda = false;
        aggiorna();
      });
    };
    window.addEventListener('scroll', suScroll, { passive: true });
    window.addEventListener('resize', suScroll);
    aggiorna();

    // deep link: /#prolasso, /#urgenza… porta l'anello su quella problematica
    const daHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const i = PROBLEMATICHE.findIndex((p) => p.id === id);
      if (i >= 0) requestAnimationFrame(() => vai(i, false));
    };
    daHash();
    window.addEventListener('hashchange', daHash);

    // La grafica 3D arriva dopo il primo caricamento: alla prima interazione o dopo qualche secondo.
    let avviato = false;
    const avvia = () => {
      if (avviato) return;
      avviato = true;
      ['pointermove', 'pointerdown', 'scroll', 'keydown', 'touchstart'].forEach((e) => window.removeEventListener(e, avvia));
      quandoLibero(async () => {
        try {
          const { monta } = await import('../three/esperienza/scena');
          scena = await monta(host);
          radice.classList.add('is-pronto');
          aggiorna();
        } catch (err) {
          console.warn('3D non disponibile: resta la versione statica.', err);
          radice.classList.remove('is-3d');
        }
      });
    };
    ['pointermove', 'pointerdown', 'scroll', 'keydown', 'touchstart'].forEach((e) =>
      window.addEventListener(e, avvia, { passive: true, once: true }),
    );
    const dopoLoad = () => window.setTimeout(avvia, 3500);
    if (document.readyState === 'complete') dopoLoad();
    else window.addEventListener('load', dopoLoad, { once: true });
    void isIdStato;
  }
</script>

<style>
  .esp {
    position: relative;
  }
  .esp__canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 900ms var(--ease);
  }
  .esp.is-pronto .esp__canvas {
    opacity: 1;
  }
  .esp :global(.stage-canvas) {
    width: 100% !important;
    height: 100% !important;
  }
  .esp > section {
    position: relative;
    z-index: 1;
  }
  .esp-num {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--color-accent-text);
    letter-spacing: 0.1em;
    margin: 0 0 var(--space-3);
  }
  .esp-testo {
    font-size: var(--fs-lead);
    max-width: 30em;
  }

  /* — Hero — */
  .esp-hero {
    min-height: calc(100svh - var(--header-h));
    display: grid;
    align-items: center;
    padding-block: var(--space-7);
    background:
      radial-gradient(60% 70% at 85% 30%, rgb(236 227 242 / 0.9), transparent 70%),
      radial-gradient(40% 50% at 0% 100%, rgb(229 237 230 / 0.8), transparent 70%);
  }
  .esp-hero__inner {
    position: relative;
    z-index: 1;
  }
  .esp-hero h1 {
    max-width: 15em;
    font-size: clamp(2.3rem, 1.6rem + 3vw, 4.2rem);
    margin-bottom: var(--space-5);
  }
  .esp-hero__sotto {
    font-size: var(--fs-lead);
    max-width: 32em;
    margin-bottom: var(--space-6);
  }
  .esp-hero__scroll {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: var(--space-7);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }
  .esp-hero__scroll span {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(var(--c-plum-500), transparent);
  }
  .esp-hero__statico {
    position: absolute;
    top: 8%;
    right: -18vw;
    width: min(70vw, 34rem);
    aspect-ratio: 1;
    opacity: 0.55;
    pointer-events: none;
    transition: opacity 600ms var(--ease);
  }
  @media (min-width: 64rem) {
    .esp-hero__statico {
      right: 4vw;
      top: 50%;
      translate: 0 -50%;
      opacity: 1;
    }
  }
  .esp.is-pronto .esp-hero__statico {
    opacity: 0;
  }

  /* — Composizione (alta, testo fisso) — */
  .esp-compone {
    padding-block: var(--section-y);
  }
  .esp.is-3d .esp-compone {
    height: 220vh;
    padding: 0;
  }
  .esp.is-3d .esp-compone__sticky {
    position: sticky;
    top: var(--header-h);
    padding-top: var(--space-7);
  }
  .esp-compone h2 {
    max-width: 14em;
    font-size: clamp(1.9rem, 1.4rem + 2.2vw, 3.2rem);
  }

  /* — Anello delle problematiche — */
  .esp-orbita {
    padding-block: var(--section-y);
  }
  .esp-orbita__voci {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .esp-voce__btn {
    display: grid;
    gap: 0.2rem;
    text-align: left;
    border: 0;
    background: none;
    padding: 0;
    cursor: pointer;
  }
  .esp-voce__frase {
    font-family: var(--font-heading);
    font-size: clamp(1.3rem, 1.1rem + 1vw, 1.8rem);
    color: var(--color-heading);
    line-height: 1.2;
  }
  .esp-voce__nome {
    font-size: var(--fs-small);
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  /* versione statica: elenco leggibile */
  .esp:not(.is-3d) .esp-orbita__voci {
    display: grid;
    gap: var(--space-5);
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .esp:not(.is-3d) .esp-voce {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border-soft);
  }
  .esp:not(.is-3d) .esp-voce__dettaglio p {
    margin: var(--space-3) 0;
  }
  .esp:not(.is-3d) .esp-orbita__pannello,
  .esp:not(.is-3d) .esp-orbita__anello {
    display: none;
  }

  /* versione 3D: sezione alta, scena fissa, voci disposte in cerchio dal codice */
  .esp.is-3d .esp-orbita {
    height: 520vh;
    padding: 0;
  }
  .esp.is-3d .esp-orbita__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
  }
  .esp.is-3d .esp-orbita__testa {
    padding-top: calc(var(--header-h) + var(--space-4));
  }
  .esp.is-3d .esp-orbita__testa h2 {
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.4rem);
    max-width: 16em;
  }
  .esp-orbita__aiuto {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }
  .esp.is-3d .esp-orbita__anello {
    position: absolute;
    left: 40%;
    top: 52%;
    width: min(60vw, 1040px);
    aspect-ratio: 1 / 0.3;
    translate: -50% -50%;
    border: 1.5px solid rgb(133 89 160 / 0.35);
    border-radius: 50%;
    pointer-events: none;
  }
  .esp.is-3d .esp-voce {
    position: absolute;
    left: 0;
    top: 0;
    max-width: 17rem;
    will-change: transform;
  }
  .esp.is-3d .esp-voce__dettaglio {
    display: none;
  }
  .esp.is-3d .esp-voce__btn {
    padding: 0.6rem 1rem;
    border-radius: var(--radius);
    background: rgb(251 248 243 / 0.82);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid transparent;
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .esp.is-3d .esp-voce.is-attiva .esp-voce__btn {
    background: var(--c-white);
    border-color: var(--c-plum-300);
    box-shadow: var(--shadow);
  }
  .esp.is-3d .esp-orbita__pannello {
    position: absolute;
    z-index: 40;
    left: var(--gutter);
    bottom: calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    width: min(26rem, calc(100% - 2 * var(--gutter)));
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--color-border-soft);
    box-shadow: var(--shadow);
  }
  .esp-orbita__pannello :global(p) {
    margin: 0 0 var(--space-3);
  }
  .esp-orbita__pannello :global(.esp-pannello__nome) {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    color: var(--color-heading);
  }
  .esp-orbita__pannello :global(a) {
    font-weight: 650;
  }
  @media (max-width: 63.99rem) {
    .esp.is-3d .esp-orbita__pannello {
      bottom: calc(var(--contactbar-h) + var(--space-4));
      padding: var(--space-4);
      font-size: 1rem;
    }
    .esp.is-3d .esp-voce {
      max-width: 12rem;
    }
    .esp.is-3d .esp-voce__frase {
      font-size: 1.05rem;
    }
    .esp.is-3d .esp-voce__nome {
      font-size: 0.8rem;
    }
    .esp.is-3d .esp-orbita__anello {
      left: 50%;
      top: 40%;
      width: 82vw;
      aspect-ratio: 1 / 0.42;
    }
  }
  @media (min-width: 64rem) {
    .esp.is-3d .esp-orbita__pannello {
      left: auto;
      right: var(--gutter);
      top: 50%;
      bottom: auto;
      translate: 0 -50%;
    }
  }

  /* — Percorso di cura — */
  .esp-percorso {
    padding-block: var(--section-y);
  }
  .esp.is-3d .esp-percorso {
    min-height: 110vh;
    display: grid;
    align-items: center;
  }
  .esp-percorso__inner {
    max-width: calc(36rem + 2 * var(--gutter));
    margin-left: max(var(--gutter), calc((100vw - var(--container)) / 2));
  }
  .esp-percorso h2 {
    font-size: clamp(1.8rem, 1.4rem + 1.8vw, 2.8rem);
  }
  .esp-passi {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0;
    padding-left: 1.4rem;
    font-size: var(--fs-lead);
  }
  .esp-passi li::marker {
    font-family: var(--font-heading);
    color: var(--color-link);
  }
  @media (max-width: 63.99rem) {
    .esp.is-3d .esp-compone__sticky .container,
    .esp.is-3d .esp-percorso__inner {
      margin-top: 52vh;
      padding: var(--space-5) var(--gutter);
      background: rgb(251 248 243 / 0.9);
      border-radius: var(--radius-lg);
    }
  }
</style>
