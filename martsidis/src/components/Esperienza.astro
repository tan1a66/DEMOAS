---
/**
 * Esperienza 3D della Home, guidata dallo scroll.
 * - Il disegno ha sempre un suo spazio: su desktop la colonna destra di ogni sezione ([data-esp-area]),
 *   su telefono un "palco" fisso in alto (.esp__sipario). I testi non gli passano mai sopra.
 * - La massa iniziale nasce crescendo e, scorrendo, si trasforma nel modello (nessuna dissolvenza).
 * - L'anello delle problematiche gira attorno al modello: le voci davanti passano sotto, quelle dietro
 *   rimpiccioliscono e spariscono dietro di lui.
 * - Il disegno statico (.esp__statico) compare SOLO se il 3D non può partire: movimento ridotto, niente WebGL, ?no3d.
 */
import Button from './Button.astro';
import HeroBlob from './HeroBlob.astro';
import { PROBLEMATICHE } from '@/three/pelvi/stati';
import { sito } from '@/data/sito';
import { useTranslations } from '@/i18n';

const t = useTranslations();
const legenda = [
  { id: 'vescica', nome: 'Vescica' },
  { id: 'utero', nome: 'Utero, tube e ovaie' },
  { id: 'retto', nome: 'Retto' },
  { id: 'pavimento', nome: 'Pavimento pelvico' },
  { id: 'bacino', nome: 'Bacino' },
];
---

<div class="esp" data-esperienza>
  <div class="esp__canvas" data-esp-canvas aria-hidden="true"></div>
  {/* Palco del modello su telefono: resta fisso sotto l'intestazione per tutta l'esperienza */}
  <div class="esp__sipario" data-esp-sipario aria-hidden="true">
    <div class="esp__statico"><HeroBlob uid="m" /></div>
  </div>

  <section class="esp-hero" data-esp="hero" aria-labelledby="hero-titolo">
    <div class="container esp-due">
      <div class="esp-col-testo">
        <p class="eyebrow">Uroginecologia a Cagliari</p>
        <h1 id="hero-titolo">Incontinenza, prolasso, pavimento pelvico: problemi comuni, che si possono curare.</h1>
        <p class="esp-hero__sotto">
          <strong>{sito.nome}</strong>, uroginecologo. {sito.ruoloOspedaliero}.
        </p>
        <Button href="/prenota-una-visita/" size="lg" icon="calendar-check" data-prenota>{t('cta.book')}</Button>
        <p class="esp-hero__scroll" aria-hidden="true"><span></span> Scorra: la massa prende forma</p>
      </div>
      <div class="esp-area" data-esp-area aria-hidden="true">
        <div class="esp__statico"><HeroBlob uid="d" /></div>
      </div>
    </div>
  </section>

  <section class="esp-compone" data-esp="compone" id="normale" aria-labelledby="compone-titolo">
    <div class="esp-fisso">
      <div class="container esp-due">
        <div class="esp-col-testo">
          <div>
            <p class="esp-num">01</p>
            <h2 id="compone-titolo">Un’amaca di muscoli sostiene vescica, utero e intestino.</h2>
          </div>
          <p class="esp-testo">
            È il pavimento pelvico. Quando cede, o è troppo teso, compaiono disturbi molto diffusi, di cui spesso non
            si parla.
          </p>
          <div>
            <ul class="esp-legenda" role="list">
              {
                legenda.map((l) => (
                  <li>
                    <i class={`esp-pall esp-pall--${l.id}`} />
                    {l.nome}
                  </li>
                ))
              }
            </ul>
            <p class="esp-nota">{t('note.modello')}</p>
          </div>
        </div>
        <div class="esp-area" data-esp-area aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="esp-orbita" data-esp="orbita" id="problematiche" aria-labelledby="orbita-titolo">
    <div class="esp-orbita__fisso">
      <div class="esp-orbita__testo">
        <div class="esp-orbita__titolo">
          <p class="esp-num">02</p>
          <h2 id="orbita-titolo">Si riconosce in una di queste situazioni?</h2>
          <p class="esp-orbita__aiuto">
            Scorra, oppure scelga una voce: il cerchio gira attorno al modello e mostra cosa succede.
          </p>
        </div>
        <div class="esp-orbita__pannello" id="esp-pannello" aria-live="polite" data-esp-pannello></div>
      </div>
      <div class="esp-orbita__scena" data-esp-scena aria-hidden="true"></div>
    </div>
    <svg class="esp-orbita__anello" data-esp-anello aria-hidden="true" focusable="false"><path></path></svg>
    <ol class="esp-voci">
      {
        PROBLEMATICHE.map((p, i) => (
          <li id={p.id} class="esp-voce" data-esp-voce={i}>
            <button type="button" class="esp-voce__btn" data-esp-vai={i} aria-describedby="esp-pannello">
              <span class="esp-voce__frase">«{p.frase}»</span>
              <span class="esp-voce__nome">{p.nome}</span>
            </button>
            <div class="esp-voce__dettaglio">
              <p>{p.testo}</p>
              <a href={p.link}>Approfondisca: {p.nome}</a>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="esp-percorso" data-esp="percorso" id="riabilitazione" aria-labelledby="percorso-titolo">
    <div class="esp-fisso">
      <div class="container esp-due">
        <div class="esp-col-testo">
          <div>
            <p class="esp-num">03</p>
            <h2 id="percorso-titolo">Il percorso di cura: si parte sempre dal più semplice.</h2>
          </div>
          <ol class="esp-passi">
            <li><strong>Prenota.</strong> Non serve spiegare il motivo, se non vuole.</li>
            <li><strong>La visita, con calma.</strong> Prima si parla, poi la visita: ogni passaggio viene spiegato.</li>
            <li>
              <strong>Le possibilità di cura.</strong> Abitudini, riabilitazione, terapie e, solo se serve, un intervento.
              Decide insieme al Dottore.
            </li>
          </ol>
          <div>
            <Button href="/prenota-una-visita/" size="lg" icon="calendar-check" data-prenota>{t('cta.book')}</Button>
          </div>
        </div>
        <div class="esp-area" data-esp-area aria-hidden="true"></div>
      </div>
    </div>
  </section>
</div>

<script>
  import { riduciMovimento, disattivatoDaUrl, webglDisponibile } from '../three/shared/capacita';
  import { PROBLEMATICHE, type IdStato } from '../three/pelvi/stati';

  type Scena = Awaited<ReturnType<typeof import('../three/esperienza/scena').monta>>;
  type Area = { x: number; y: number; w: number; h: number };

  const clamp = (v: number, a = 0, b = 1) => Math.min(Math.max(v, a), b);
  const ease = (t: number) => t * t * (3 - 2 * t);
  /** Scala di una voce: grande davanti (prof = 1), piccola di lato, sparisce dietro al modello (prof → -1). */
  const scalaVoce = (prof: number) => (0.55 + 0.45 * ((prof + 1) / 2)) * ease(clamp((prof + 0.95) / 0.6));

  function avvia(radice: HTMLElement) {
    const q = (s: string) => radice.querySelector<HTMLElement>(s)!;
    const host = q('[data-esp-canvas]');
    const hero = q('[data-esp="hero"]');
    const compone = q('[data-esp="compone"]');
    const orbita = q('[data-esp="orbita"]');
    const percorso = q('[data-esp="percorso"]');
    const sipario = q('[data-esp-sipario]');
    const scenaEl = q('[data-esp-scena]');
    const tracciato = radice.querySelector<SVGPathElement>('[data-esp-anello] path')!;
    const pannello = q('[data-esp-pannello]');
    const voci = [...radice.querySelectorAll<HTMLElement>('[data-esp-voce]')];
    const header = document.querySelector<HTMLElement>('[data-header]');
    const N = voci.length;
    const mq = window.matchMedia('(max-width: 63.99rem)');
    let scena: Scena | null = null;
    let attiva = -1;

    // Se lo script viene rieseguito (anteprima in un file: si torna alla Home), chiude l'istanza precedente.
    const w = window as Window & { __espFine?: () => void };
    w.__espFine?.();
    const ctl = new AbortController();
    const signal = ctl.signal;
    w.__espFine = () => {
      ctl.abort();
      scena?.dispose();
    };

    radice.classList.add('is-3d');

    // — Geometria dell'anello: centro, raggi e raggio libero per il modello (R) —
    const geo = { cx: 0, cy: 0, rx: 0, ryF: 0, ryB: 0, R: 80 };
    // Percorso delle voci: un ovale "squadrato" (superellisse), più piatto davanti, così il modello ha più spazio.
    const P = 0.55;
    const sx = (a: number) => Math.sign(Math.sin(a)) * Math.pow(Math.abs(Math.sin(a)), P);
    const sy = (a: number) => Math.sign(Math.cos(a)) * Math.pow(Math.abs(Math.cos(a)), P);
    const punto = (a: number, k = 1): [number, number] => [
      geo.cx + sx(a) * geo.rx * k,
      geo.cy + sy(a) * (Math.cos(a) >= 0 ? geo.ryF : geo.ryB) * k,
    ];
    const DISTACCO = 14; // spazio tra il modello e la voce davanti
    const misura = () => {
      const vh = window.innerHeight;
      const hH = header?.offsetHeight ?? 72;
      const mobile = mq.matches;
      const r = (mobile ? sipario : scenaEl).getBoundingClientRect();
      const reg = { x: r.left, y: hH, w: r.width, h: mobile ? r.height : vh - hH };
      const vw = Math.max(...voci.map((v) => v.offsetWidth));
      const vhh = Math.max(...voci.map((v) => v.offsetHeight));
      const rx = mobile
        ? Math.min((reg.w / 2 - 4 - (vw / 2) * 0.92) / 0.86, (reg.w / 2 - 2 - (vw / 2) * 0.74) / 0.985)
        : Math.min(reg.w / 2 - vw / 2 - 8, 520);
      // R: il più grande possibile senza che le voci della metà davanti tocchino il modello
      let R = Math.min((reg.h - vhh - DISTACCO - 16) / 2, reg.w / 2 - 8);
      for (let k = 0; k < 80; k++) {
        const ryF = R + vhh / 2 + DISTACCO;
        let min = Infinity;
        for (let g = -90; g <= 90; g += 3) {
          const a = (g * Math.PI) / 180;
          const s = scalaVoce(Math.cos(a));
          const dx = Math.max(Math.abs(sx(a)) * rx - (vw / 2) * s, 0);
          const dy = Math.max(sy(a) * ryF - (vhh / 2) * s, 0);
          min = Math.min(min, Math.hypot(dx, dy));
        }
        if (min >= R + 8) break;
        R -= 2;
      }
      R = Math.max(R, 40);
      geo.R = R;
      geo.rx = rx;
      geo.ryF = R + vhh / 2 + DISTACCO;
      geo.ryB = R * 0.5;
      geo.cx = reg.x + reg.w / 2;
      geo.cy = reg.y + (reg.h - (2 * R + vhh + DISTACCO + 16)) / 2 + 8 + R;
    };

    // — Stato dell'esperienza in base allo scroll —
    const leggi = () => {
      const vh = window.innerHeight;
      const hH = header?.offsetHeight ?? 72;
      const mobile = mq.matches;
      const stick = mobile ? hH + sipario.offsetHeight : hH; // linea sotto cui scorrono i testi
      const rComp = compone.getBoundingClientRect();
      const rOrb = orbita.getBoundingClientRect();
      const rPerc = percorso.getBoundingClientRect();
      const mid = (stick + vh) / 2;
      const quale = rPerc.top <= mid ? 'percorso' : rOrb.top <= mid ? 'orbita' : rComp.top <= mid ? 'compone' : 'hero';
      // la trasformazione occupa quasi tutta la sezione "compone": si vede accadere mentre si scorre
      const montaggio = clamp(
        ((mobile ? vh * 0.75 : vh * 0.3) - rComp.top) / Math.max(rComp.height - vh * (mobile ? 0.5 : 0.9), vh * 0.6),
      );
      const corsa = Math.max(rOrb.height - (vh - stick), 1);
      const indice = clamp((stick - rOrb.top) / corsa) * (N - 1);
      const nuova = Math.round(indice);
      // l'anello "cresce" entrando nella sezione e si richiude uscendo (legato allo scroll, niente dissolvenze)
      const apertura = Math.min(
        clamp((mid - rOrb.top) / Math.max(mid - stick, 1)),
        clamp((rOrb.bottom - vh * 0.45) / (vh * 0.55)),
      );
      let area: Area;
      if (quale === 'orbita') {
        area = { x: geo.cx - geo.R, y: geo.cy - geo.R, w: geo.R * 2, h: geo.R * 2 };
      } else if (mobile) {
        const r = sipario.getBoundingClientRect();
        area = { x: r.left + 8, y: r.top + 8, w: r.width - 16, h: r.height - 16 };
      } else {
        const sezione = quale === 'hero' ? hero : quale === 'compone' ? compone : percorso;
        const r = sezione.querySelector<HTMLElement>('[data-esp-area]')!.getBoundingClientRect();
        const yc = hH + (vh - hH - r.height) / 2; // centrato nella fascia sotto l'intestazione
        const y = quale === 'hero' ? Math.max(r.top, yc) : quale === 'compone' ? yc : Math.min(r.top, yc);
        area = { x: r.left, y, w: r.width, h: r.height };
      }
      const stato: IdStato =
        quale === 'orbita' ? PROBLEMATICHE[nuova]!.id : quale === 'percorso' ? 'riabilitazione' : 'normale';
      return { quale, montaggio, indice, nuova, apertura, area, stato, stick };
    };

    const comando = (s: ReturnType<typeof leggi>) => ({
      montaggio: s.montaggio,
      stato: s.stato,
      giro: s.quale === 'orbita' ? -s.indice * 0.35 : 0,
      area: s.area,
    });

    // Le voci girano attorno al modello: davanti (in basso) grandi, dietro rimpiccioliscono fino a sparire.
    const disponi = (indice: number, apertura: number) => {
      const e = ease(apertura);
      const k = 1 + (1 - e) * 0.3;
      voci.forEach((v, i) => {
        const a = ((i - indice) / N) * Math.PI * 2;
        const prof = Math.cos(a);
        const [x, y] = punto(a, k);
        v.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) translate(-50%, -50%) scale(${(scalaVoce(prof) * e).toFixed(3)})`;
        v.style.zIndex = String(Math.round(prof * 10) + 20);
        v.classList.toggle('is-dietro', prof < 0.55);
      });
      // la linea dell'orbita segue lo stesso percorso e passa dietro al modello
      let d = '';
      for (let g = 0; g <= 360; g += 5) {
        const [x, y] = punto((g * Math.PI) / 180, k);
        d += `${g ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
      }
      tracciato.setAttribute('d', d + 'Z');
      tracciato.style.strokeWidth = (1.5 * e).toFixed(2);
    };

    const mostra = (i: number) => {
      attiva = i;
      voci.forEach((v, k) => v.classList.toggle('is-attiva', k === i));
      const p = PROBLEMATICHE[i]!;
      const dettaglio = voci[i]!.querySelector('.esp-voce__dettaglio')!;
      pannello.innerHTML = `<p class="esp-pannello__nome">${p.nome}</p><p class="esp-pannello__frase">«${p.frase}»</p>${dettaglio.innerHTML}`;
    };

    const aggiorna = () => {
      const s = leggi();
      scena?.comanda(comando(s));
      // quando l'area è uscita dallo schermo il disegno non serve più (esce scorrendo, senza dissolvenze)
      host.style.visibility = s.area.y + s.area.h < 0 ? 'hidden' : '';
      host.dataset.area = [s.area.x, s.area.y, s.area.w, s.area.h].map(Math.round).join(','); // utile per i test
      disponi(s.indice, s.apertura);
      radice.classList.toggle('is-orbita', s.apertura > 0.6);
      if (s.nuova !== attiva && (s.quale === 'orbita' || attiva < 0)) mostra(s.nuova);
    };

    // clic (o focus da tastiera) su una voce: lo scroll porta il cerchio su quella problematica
    const vai = (i: number, liscio = true) => {
      const s = leggi();
      const rOrb = orbita.getBoundingClientRect();
      const corsa = rOrb.height - (window.innerHeight - s.stick);
      window.scrollTo({
        top: window.scrollY + rOrb.top - s.stick + (i / (N - 1)) * corsa + 1,
        behavior: liscio ? 'smooth' : 'auto',
      });
    };
    radice.querySelectorAll<HTMLButtonElement>('[data-esp-vai]').forEach((b) => {
      const i = Number(b.dataset.espVai);
      b.addEventListener('click', () => vai(i));
      b.addEventListener('focus', () => {
        if (!radice.classList.contains('is-orbita')) vai(i, false);
      });
    });

    // trascinare sul disegno lo fa ruotare (su touch solo in orizzontale: lo scroll verticale resta libero)
    let drag: { x: number; y: number; id: number } | null = null;
    radice.addEventListener('pointerdown', (e) => {
      const bersaglio = e.target as HTMLElement;
      if (!bersaglio.closest('[data-esp-area], [data-esp-sipario], [data-esp-scena]')) return;
      drag = { x: e.clientX, y: e.clientY, id: e.pointerId };
    });
    window.addEventListener(
      'pointermove',
      (e) => {
        if (!drag || e.pointerId !== drag.id) return;
        scena?.trascina(e.clientX - drag.x, e.pointerType === 'touch' ? 0 : e.clientY - drag.y);
        drag.x = e.clientX;
        drag.y = e.clientY;
      },
      { signal },
    );
    const fineDrag = () => (drag = null);
    window.addEventListener('pointerup', fineDrag, { signal });
    window.addEventListener('pointercancel', fineDrag, { signal });

    let inCoda = false;
    const pianifica = () => {
      if (inCoda) return;
      inCoda = true;
      requestAnimationFrame(() => {
        inCoda = false;
        aggiorna();
      });
    };
    window.addEventListener('scroll', pianifica, { passive: true, signal });
    window.addEventListener(
      'resize',
      () => {
        misura();
        pianifica();
      },
      { signal },
    );
    misura();
    aggiorna();
    document.fonts?.ready.then(() => {
      misura();
      aggiorna();
    });

    // deep link: /#prolasso, /#urgenza… porta il cerchio su quella problematica
    const daHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const i = PROBLEMATICHE.findIndex((p) => p.id === id);
      if (i >= 0) requestAnimationFrame(() => vai(i, false));
    };
    daHash();
    window.addEventListener('hashchange', daHash, { signal });

    // Il 3D parte subito: non c'è una versione statica "prima". La massa nasce crescendo.
    (async () => {
      try {
        const { monta } = await import('../three/esperienza/scena');
        scena = await monta(host, comando(leggi()));
        if (signal.aborted) return scena.dispose();
        radice.classList.add('is-pronto');
        aggiorna();
      } catch (errore) {
        console.warn('3D non disponibile: resta la versione statica.', errore);
        radice.classList.remove('is-3d');
        radice.classList.add('is-statico');
      }
    })();
  }

  const radice = document.querySelector<HTMLElement>('[data-esperienza]');
  if (radice) {
    if (disattivatoDaUrl() || riduciMovimento() || !webglDisponibile()) radice.classList.add('is-statico');
    else avvia(radice);
  }
</script>

<style>
  .esp {
    position: relative;
    --stage-h: 44svh;
  }

  /* — Tela 3D: fissa, sopra ai testi ma mai sovrapposta (il modello sta nelle aree riservate) — */
  .esp__canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100lvh; /* iPhone: non cambia quando la barra di Safari compare o scompare */
    z-index: 3;
    pointer-events: none;
    visibility: hidden;
  }
  .esp.is-pronto .esp__canvas {
    visibility: visible;
  }
  .esp :global(.stage-canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  /* Disegno statico: solo se il 3D non può partire */
  .esp__statico {
    display: none;
    width: 100%;
    height: 100%;
  }
  .esp.is-statico .esp__statico {
    display: block;
  }

  /* — Palco del modello su telefono — */
  .esp__sipario {
    display: none;
  }
  @media (max-width: 63.99rem) {
    /* sempre presente su telefono (anche prima che parta lo script): nessun salto di layout */
    .esp__sipario {
      display: block;
      height: var(--stage-h);
      background: radial-gradient(70% 80% at 60% 40%, var(--c-plum-50), var(--color-bg) 78%);
    }
    .esp.is-3d .esp__sipario {
      position: sticky;
      top: var(--header-h);
      z-index: 2;
      touch-action: pan-y;
      border-bottom: 1px solid var(--color-border-soft);
    }
  }

  /* — Due colonne: testo a sinistra, area del disegno a destra (desktop) — */
  .esp-due {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .esp-area {
    display: none;
  }
  .esp-col-testo {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .esp-col-testo :global(h1),
  .esp-col-testo :global(h2),
  .esp-col-testo p {
    margin: 0;
  }
  @media (min-width: 64rem) {
    .esp.is-3d .esp-due,
    .esp-hero .esp-due {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      gap: var(--space-8);
    }
    .esp.is-3d .esp-area,
    .esp-hero .esp-area {
      display: block;
      justify-self: center;
      width: min(100%, 36rem, calc(100svh - var(--header-h) - 5rem));
      aspect-ratio: 1;
    }
    .esp.is-3d .esp-area {
      cursor: grab;
      touch-action: pan-y;
    }
  }

  .esp-num {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--color-accent-text);
    letter-spacing: 0.1em;
    margin: 0 0 var(--space-3) !important;
  }
  .esp-testo {
    font-size: var(--fs-lead);
    max-width: 30em;
  }

  /* — Hero — */
  .esp-hero {
    display: grid;
    align-items: center;
    padding-block: var(--space-6);
    min-height: calc(100svh - var(--header-h) - var(--stage-h));
  }
  .esp-hero h1 {
    font-size: clamp(1.9rem, 1.3rem + 2.7vw, 3.6rem);
    max-width: 13em;
  }
  .esp-hero__sotto {
    font-size: var(--fs-lead);
    max-width: 30em;
  }
  .esp-hero__scroll {
    display: flex;
    align-items: center;
    gap: 0.75rem;
