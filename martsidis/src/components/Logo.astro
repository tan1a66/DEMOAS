---
/**
 * Marchio: monogramma "M" con sotto un arco salvia (l'"amaca" del pavimento pelvico che sostiene).
 * Stesso disegno di public/favicon.svg (rigenerare le icone con: node scripts/genera-icone.mjs).
 */
import { sito } from '@/data/sito';

interface Props {
  tone?: 'default' | 'light';
  href?: string;
}
const { tone = 'default', href = '/' } = Astro.props;
---

<a href={href} class:list={['logo', `logo--${tone}`]} aria-label={`${sito.nome}, home`}>
  <svg class="logo__mark" viewBox="0 0 40 40" width="44" height="44" aria-hidden="true" focusable="false">
    <rect width="40" height="40" rx="12" fill="var(--c-plum-700)"></rect>
    <path d="M12 26.5V13.5l8 9 8-9v13" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M10.5 30.5Q20 35.5 29.5 30.5" fill="none" stroke="var(--c-sage-200)" stroke-width="2.4" stroke-linecap="round"></path>
  </svg>
  <span class="logo__text">
    <span class="logo__name">{sito.nome}</span>
    <span class="logo__sub">{sito.sottotitoloLogo}</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: var(--tap);
    text-decoration: none;
    color: var(--color-heading);
  }
  .logo:hover {
    color: var(--color-heading);
  }
  .logo__mark {
    flex-shrink: 0;
    width: 2.6rem;
    height: 2.6rem;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .logo__name {
    font-family: var(--font-heading);
    font-weight: 550;
    font-size: clamp(1.02rem, 0.95rem + 0.35vw, 1.2rem);
    letter-spacing: -0.005em;
  }
  .logo__sub {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-accent-text);
  }
  .logo--light {
    color: var(--c-white);
  }
  .logo--light:hover {
    color: var(--c-white);
  }
  .logo--light .logo__sub {
    color: var(--c-sage-200);
  }
  @media (max-width: 26rem) {
    .logo__sub {
      display: none;
    }
    .logo__name {
      font-size: 1rem;
    }
  }
</style>
