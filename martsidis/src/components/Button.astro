---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import type { NomeIcona } from './icone';
import { useTranslations } from '@/i18n';

type Props = {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'light';
  size?: 'md' | 'lg';
  icon?: NomeIcona;
  iconRight?: NomeIcona;
  /** Apre in nuova finestra (aggiunge rel e testo per screen reader). */
  external?: boolean;
  block?: boolean;
  class?: string;
} & Omit<HTMLAttributes<'a'>, 'href' | 'class'>;

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconRight,
  external = false,
  block = false,
  class: className,
  ...rest
} = Astro.props;
const t = useTranslations();
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, { 'btn--block': block }, className]}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
  {...rest}
>
  {icon && <Icon name={icon} size={size === 'lg' ? 24 : 22} />}
  <span><slot /></span>
  {iconRight && <Icon name={iconRight} size={20} />}
  {external && <span class="visually-hidden">{t('a11y.newwindow')}</span>}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    min-height: 3.25rem;
    padding: 0.7em 1.4em;
    border: 2px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-weight: 650;
    font-size: 1.0625rem;
    line-height: 1.2;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .btn--lg {
    min-height: 3.75rem;
    padding: 0.8em 1.7em;
    font-size: 1.125rem;
  }

  .btn--block {
    display: flex;
    width: 100%;
  }

  .btn--primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: 0 6px 18px rgb(85 56 114 / 0.22);
  }
  .btn--primary:hover {
    background: var(--color-primary-hover);
    color: var(--color-on-primary);
    box-shadow: 0 8px 24px rgb(85 56 114 / 0.28);
  }

  .btn--secondary {
    background: var(--color-surface);
    color: var(--color-primary);
    border-color: var(--c-plum-300);
  }
  .btn--secondary:hover {
    color: var(--color-primary-hover);
    border-color: var(--color-primary);
    background: var(--c-plum-50);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-primary);
    padding-inline: 0.4em;
    min-height: var(--tap);
  }
  .btn--ghost:hover {
    color: var(--color-primary-hover);
    text-decoration: underline;
  }

  .btn--light {
    background: var(--c-white);
    color: var(--c-plum-800);
  }
  .btn--light:hover {
    background: var(--c-plum-50);
    color: var(--c-plum-900);
  }

  @media (prefers-reduced-motion: no-preference) {
    .btn--primary:hover,
    .btn--light:hover {
      transform: translateY(-1px);
    }
  }
</style>
