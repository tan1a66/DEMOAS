---
/** Tutti i servizi: card generate dalle pagine con il campo `card` (src/content/pagine/*.md). */
import { getCollection, getEntry, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Card from '@/components/Card.astro';
import CTA from '@/components/CTA.astro';
import NotaDivulgativa from '@/components/NotaDivulgativa.astro';
import { serviziElenco } from '@/data/medico';
import { useTranslations } from '@/i18n';
import '@/styles/prose.css';

const pagina = await getEntry('pagine', 'servizi');
if (!pagina) throw new Error('Manca src/content/pagine/servizi.md');
const { Content } = await render(pagina);
const d = pagina.data;
const t = useTranslations();

const tutte = await getCollection('pagine', (p) => !!p.data.card);
const servizi = tutte
  .map((p) => ({ href: p.id === 'uroginecologia' ? '/uroginecologia/' : `/${p.id}/`, ...p.data.card! }))
  .sort((a, b) => a.ordine - b.ordine);
const [principale, ...altri] = servizi;

const breadcrumbs = [
  { label: t('breadcrumb.home'), href: '/' },
  { label: 'Servizi', href: '/servizi/' },
];
---

<Base title={d.metaTitle} description={d.description} breadcrumbs={breadcrumbs}>
  <PageHero titolo={d.titolo} eyebrow={d.eyebrow} lead={d.lead} />

  <Section id="elenco" title="Visite, esami e trattamenti" tone="alt">
    {
      principale && (
        <div class="principale">
          <Card title={principale.titolo} href={principale.href} icon={principale.icona} tone="plum" linkLabel="Scopra di più" as="h3">
            <p>{principale.testo}</p>
          </Card>
        </div>
      )
    }
    <ul class="griglia" role="list">
      {
        altri.map((s) => (
          <li>
            <Card title={s.titolo} href={s.href} icon={s.icona} size="sm" linkLabel="Scopra di più" as="h3">
              <p>{s.testo}</p>
            </Card>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="in-sintesi" title="In sintesi, in studio">
    <div class="sintesi">
      <ul class="sintesi__lista" role="list">
        {serviziElenco.map((s) => <li>{s}</li>)}
      </ul>
      <div class="prose">
        <Content />
      </div>
    </div>
    <CTA />
    <NotaDivulgativa />
  </Section>
</Base>

<style>
  .principale {
    margin-bottom: var(--space-5);
  }
  .principale :global(.card__title) {
    font-size: var(--fs-h2);
  }
  .griglia {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sintesi {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 56rem) {
    .sintesi {
      grid-template-columns: 1fr 1fr;
    }
  }
  .sintesi__lista {
    display: grid;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sintesi__lista li {
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    background: var(--color-bg-alt);
    font-weight: 550;
  }
</style>
