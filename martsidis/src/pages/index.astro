---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import Button from '@/components/Button.astro';
import Foto from '@/components/Foto.astro';
import Recensioni from '@/components/Recensioni.astro';
import ContattiBlocco from '@/components/ContattiBlocco.astro';
import Esperienza from '@/components/Esperienza.astro';
import { sito } from '@/data/sito';

const servizi = [
  { titolo: 'Uroginecologia', href: '/uroginecologia/' },
  { titolo: 'Esame urodinamico', href: '/esame-urodinamico/' },
  { titolo: 'Ginecologia', href: '/ginecologia/' },
  { titolo: 'Ostetricia', href: '/ostetricia/' },
  { titolo: 'Ecografia 3D/4D', href: '/ecografia-3d-4d/' },
  { titolo: 'Laser', href: '/laser/' },
  { titolo: 'Visita a domicilio', href: '/visita-domiciliare/' },
  { titolo: 'Consulenza nutrizionale', href: '/consulenza-nutrizionale/' },
];
---

<Base
  title="Uroginecologo a Cagliari | Dott. Konstantinos Martsidis"
  description="Incontinenza urinaria, prolasso e disturbi del pavimento pelvico: visite uroginecologiche, esame urodinamico, ginecologia, ostetricia ed ecografia 3D/4D a Cagliari."
>
  {/* il modello 3D si scarica in parallelo alla pagina: la massa compare prima */}
  <link slot="head" rel="preload" href="/models/pelvi.glb" as="fetch" crossorigin />
  <Esperienza />

  <div class="dopo">
    <Section id="chi-e">
      <div class="chi">
        <div class="chi__foto">
          <Foto nome="ritratto" alt={`Ritratto del ${sito.nome}`} descrizione="ritratto del Dott. Martsidis" ratio="4 / 5" />
        </div>
        <div>
          <p class="eyebrow">Il Dottore</p>
          <h2>{sito.nome}</h2>
          <p class="lead">
            Uroginecologo, responsabile dell’Ambulatorio di Uroginecologia del Policlinico Universitario di Cagliari.
            Specializzato con lode, socio AIUG, autore di lavori scientifici sul pavimento pelvico. Riceve in italiano,
            inglese e greco.
          </p>
          <Button href="/chi-sono/" variant="secondary" iconRight="arrow-right">Il curriculum</Button>
        </div>
      </div>
    </Section>

    <Section id="servizi" tone="alt">
      <p class="eyebrow servizi__occhiello">Nello studio</p>
      <ul class="servizi" role="list">
        {
          servizi.map((s) => (
            <li>
              <a href={s.href}>{s.titolo}</a>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="recensioni" title="Cosa dicono le pazienti">
      <Recensioni />
    </Section>

    <Section id="contatti" tone="alt" title="Dove riceve" intro="Via Edmondo De Magistris 29, primo piano, Cagliari. Si riceve su appuntamento.">
      <ContattiBlocco />
    </Section>
  </div>
</Base>

<style>
  .dopo {
    position: relative;
    z-index: 1;
    background: var(--color-bg);
  }
  .chi {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 56rem) {
    .chi {
      grid-template-columns: 0.7fr 1.3fr;
    }
  }
  .chi__foto {
    max-width: 24rem;
  }
  .servizi {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.15em 0.75em;
    max-width: 22em;
    margin: 0 auto;
    text-align: center;
    padding: 0;
    list-style: none;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 1.1rem + 2.4vw, 3.2rem);
    line-height: 1.15;
  }
  .servizi__occhiello {
    text-align: center;
  }
  .servizi a {
    color: var(--color-heading);
    text-decoration: none;
    background: linear-gradient(var(--c-plum-300), var(--c-plum-300)) 0 100% / 0 2px no-repeat;
    transition: background-size var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .servizi a:hover,
  .servizi a:focus-visible {
    color: var(--color-link);
    background-size: 100% 2px;
  }
</style>
