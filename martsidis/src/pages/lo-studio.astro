---
/**
 * Lo Studio: ambienti (foto in src/assets/foto/studio-1…3), strumentazione, collaborazioni, dove si trova.
 * [DA VERIFICARE CON IL MEDICO] descrizione degli ambienti e dell'accessibilità.
 */
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Foto from '@/components/Foto.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import ContattiBlocco from '@/components/ContattiBlocco.astro';
import { sito } from '@/data/sito';
import { strumentazione } from '@/data/medico';
import { useTranslations } from '@/i18n';

const t = useTranslations();
const breadcrumbs = [
  { label: t('breadcrumb.home'), href: '/' },
  { label: 'Lo Studio', href: '/lo-studio/' },
];

const punti = [
  {
    icona: 'shield-check',
    titolo: 'Riservatezza',
    testo: 'Si riceve solo su appuntamento, con il tempo necessario per parlare con calma.',
  },
  {
    icona: 'scan-line',
    titolo: 'Ecografo 2D, 3D e 4D',
    testo: `Un ${strumentazione.ecografo} per ecografie ginecologiche, ostetriche e uroginecologiche, anche con immagini tridimensionali.`,
  },
  {
    icona: 'activity',
    titolo: 'Esami uroginecologici',
    // [DA VERIFICARE CON IL MEDICO] l'esame urodinamico si esegue nello studio privato?
    testo: 'In studio si eseguono la visita uroginecologica, l’uroflussometria e l’esame urodinamico.',
  },
  {
    icona: 'languages',
    titolo: 'Tre lingue',
    testo: 'Il Dottore riceve in italiano, inglese e greco.',
  },
] as const;
---

<Base
  title="Lo Studio | Dott. Martsidis, ginecologo e uroginecologo a Cagliari"
  description="Lo studio del Dott. Konstantinos Martsidis in Via De Magistris 29 a Cagliari: su appuntamento, con ecografo 3D/4D ed esami uroginecologici. Come arrivare."
  breadcrumbs={breadcrumbs}
>
  <PageHero
    titolo="Lo Studio"
    eyebrow={`${sito.indirizzo.via}, Cagliari`}
    lead="Uno spazio tranquillo, al primo piano, dove si riceve su appuntamento. Qui il Dottore esegue visite, ecografie ed esami uroginecologici."
  />

  <Section id="ambienti" title="Gli ambienti">
    <div class="galleria">
      <Foto nome="studio-1" alt="La sala d’attesa dello studio" descrizione="sala d’attesa" ratio="4 / 3" sizes="(min-width: 56rem) 50vw, 100vw" />
      <Foto nome="studio-2" alt="L’ambulatorio per le visite" descrizione="ambulatorio" ratio="4 / 3" sizes="(min-width: 56rem) 25vw, 100vw" />
      <Foto nome="ecografo" alt={`L’ecografo ${strumentazione.ecografo}`} descrizione="ecografo Samsung HM70A Plus" ratio="4 / 3" sizes="(min-width: 56rem) 25vw, 100vw" />
    </div>
  </Section>

  <Section id="cosa-trova" title="Cosa trova in studio" tone="alt">
    <ul class="punti" role="list">
      {
        punti.map((p) => (
          <li>
            <span class="punti__icona">
              <Icon name={p.icona} size={26} />
            </span>
            <h3>{p.titolo}</h3>
            <p>{p.testo}</p>
          </li>
        ))
      }
    </ul>
    <p class="collab">
      Nello studio collabora anche la <a href="/consulenza-nutrizionale/">Dott.ssa Manuela Frau, biologa nutrizionista</a>.
    </p>
    <Button href="/servizi/" variant="secondary" iconRight="arrow-right">Tutti i servizi</Button>
  </Section>

  <Section id="dove" title="Dove si trova">
    <ContattiBlocco />
  </Section>
</Base>

<style>
  .galleria {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 56rem) {
    .galleria {
      grid-template-columns: 2fr 1fr 1fr;
      align-items: start;
    }
  }
  .punti {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
  }
  .punti li {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border-soft);
  }
  .punti__icona {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-3);
    border-radius: 50%;
    background: var(--c-plum-50);
    color: var(--color-primary);
  }
  .punti h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-2);
  }
  .punti p {
    margin: 0;
    color: var(--color-text-muted);
  }
  .collab {
    margin-bottom: var(--space-5);
  }
</style>
