# Statistiche cookieless (facoltative). Lasciare "none" per non caricare nulla.
# Valori ammessi: none | plausible | umami
PUBLIC_ANALYTICS_PROVIDER=none

# URL dello script. Meglio self-hosted o servito dal dominio del sito (proxy),
# così nessuna risorsa di terze parti viene caricata dal browser della paziente.
#   Plausible: https://plausible.io/js/script.js  (o la propria istanza)
#   Umami:     https://<istanza-umami>/script.js
PUBLIC_ANALYTICS_SCRIPT_URL=

# Plausible: il dominio del sito (es. www.ginecologiacagliari.com)
# Umami: il "website ID" (UUID) preso dal pannello di Umami
PUBLIC_ANALYTICS_SITE_ID=
