{
  "name": "carnal-sitio",
  "private": true,
  "version": "0.1.0",
  "description": "CARNAL — carnicería boutique en Mérida, Yucatán. Sitio de una sola página con recorrido de scroll.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:preview": "vite build --config vite.preview.config.ts",
    "mapa": "node scripts/build-mapa.mjs",
    "estaticos": "node scripts/estaticos.mjs http://localhost:5199/",
    "capturas": "node scripts/capturas.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@react-three/fiber": "^9.8.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.3"
  }
